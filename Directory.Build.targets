<Project>
  <!-- Like Beans: the last version component is the full Git history count.
       Archives without Git metadata report build 0 and cannot self-update. -->
  <Target Name="DocumentBuildVersion" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
    <Exec Command="git rev-list --count HEAD" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="DocumentBuildCount" />
      <Output TaskParameter="ExitCode" PropertyName="DocumentCountExit" />
    </Exec>
    <Exec Command="git rev-parse HEAD" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="DocumentCommit" />
      <Output TaskParameter="ExitCode" PropertyName="DocumentCommitExit" />
    </Exec>
    <PropertyGroup>
      <DocumentBuildCount Condition="'$(DocumentCountExit)' != '0'">0</DocumentBuildCount>
      <DocumentCommit Condition="'$(DocumentCommitExit)' != '0'"></DocumentCommit>
      <Version>$(DocumentVersionSeries).$(DocumentBuildCount)</Version>
      <AssemblyVersion>$(DocumentVersionSeries).0.0</AssemblyVersion>
      <FileVersion>$(DocumentVersionSeries).$(DocumentBuildCount).0</FileVersion>
      <InformationalVersion>$(DocumentVersionSeries).$(DocumentBuildCount.PadLeft(3, '0'))</InformationalVersion>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="BuildNumber" Value="$(DocumentBuildCount)" />
      <AssemblyMetadata Include="RepositoryCommit" Value="$(DocumentCommit)" />
    </ItemGroup>
  </Target>
</Project>

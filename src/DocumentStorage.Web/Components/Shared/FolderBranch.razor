<div class="tree-branch @(Depth == 0 ? "tree-top" : "")">
    <div class="tree-row @(SelectedId == Folder.Id ? "selected" : "") @(Online ? "" : "offline")" style="--depth:@Depth">
        <button class="tree-toggle @(expanded ? "open" : "")" aria-label="@((expanded ? "Collapse " : "Expand ") + Folder.Name)" aria-expanded="@(expanded ? "true" : "false")" disabled="@(!Children.Any())" @onclick="() => expanded = !expanded"><Icon Name="arrow" Size="11" Stroke="2.2" /></button>
        <a class="tree-label" href="@($"/library?folder={Folder.Id}")" aria-current="@(SelectedId == Folder.Id ? "page" : null)" @onclick="() => OnNavigate.InvokeAsync()">
            <Icon Name="@IconName" Size="16" />
            <span>@Folder.Name</span>
            @if (Folder.IsIntake) { <span class="tree-tag">Inbox</span> }
        </a>
    </div>
    @if (expanded)
    {
        @foreach (var child in Children)
        {
            <FolderBranch @key="child.Id" Folder="child" AllFolders="AllFolders" SelectedId="SelectedId" Depth="@(Depth + 1)" OnNavigate="OnNavigate" Online="Online" />
        }
    }
</div>
@code {
    [Parameter, EditorRequired] public CatalogEntry Folder { get; set; } = default!;
    [Parameter, EditorRequired] public List<CatalogEntry> AllFolders { get; set; } = [];
    [Parameter] public Guid? SelectedId { get; set; }
    [Parameter] public int Depth { get; set; }
    [Parameter] public bool Network { get; set; }
    [Parameter] public bool Online { get; set; } = true;
    [Parameter] public EventCallback OnNavigate { get; set; }
    private bool expanded, touched;
    private Guid? lastSelected;
    private string IconName => Depth == 0 ? (Network ? "nas" : "drive") : Folder.IsIntake ? "inbox" : "folder";
    private IEnumerable<CatalogEntry> Children => AllFolders.Where(x => x.ParentId == Folder.Id).OrderBy(x => x.Name, StringComparer.CurrentCultureIgnoreCase);
    protected override void OnParametersSet()
    {
        // Storage roots start open; deeper folders open themselves when the selection is inside them.
        if (!touched) { expanded = Depth == 0; touched = true; }
        if (SelectedId != lastSelected) { lastSelected = SelectedId; if (SelectedId != Folder.Id && Contains(SelectedId)) expanded = true; }
    }
    private bool Contains(Guid? id)
    {
        var current = AllFolders.FirstOrDefault(x => x.Id == id);
        while (current?.ParentId != null) { if (current.ParentId == Folder.Id) return true; current = AllFolders.FirstOrDefault(x => x.Id == current.ParentId); }
        return false;
    }
}

@inject IJSRuntime JS
@inject DocumentStorage.Core.Formats.DocumentFormatRegistry Formats
@implements IAsyncDisposable

<section class="document-preview" @ref="element" aria-label="Document preview">
    <div class="document-preview-heading"><strong>@Entry.Name</strong><div><a class="icon-button small" href="@($"/documents/{Entry.Id}/download")" download aria-label="Download original" title="Download original"><Icon Name="download" Size="16" /></a><button type="button" class="text-button" data-action="expand" aria-label="Expand preview">Expand</button></div></div>
    @if (format.Kind != "unsupported" && Entry.Size <= format.Limit)
    {
        <div class="preview-toolbar" aria-label="Preview controls">
            @if (format.Kind is "pdf" or "raster")
            {
                <button type="button" data-action="previous" aria-label="@(format.Kind == "pdf" ? "Previous PDF page" : "Previous image page")" disabled>‹</button><input type="number" data-page min="1" value="1" aria-label="@(format.Kind == "pdf" ? "PDF page" : "Image page")" disabled /><span data-pages>of —</span><button type="button" data-action="next" aria-label="@(format.Kind == "pdf" ? "Next PDF page" : "Next image page")" disabled>›</button>
            }
            @if (format.Kind is "pdf" or "image" or "raster")
            {
                <span class="tool-gap"></span><button type="button" data-action="out" aria-label="Zoom out" disabled>−</button><span data-zoom>Fit</span><button type="button" data-action="in" aria-label="Zoom in" disabled>+</button><button type="button" data-action="fit" aria-label="Fit width" title="Fit width" disabled><Icon Name="fit-width" Size="16" /></button><button type="button" data-action="rotate" aria-label="Rotate" title="Rotate" disabled><Icon Name="rotate" Size="16" /></button><span class="tool-gap"></span>
            }
            @if (format.Kind == "pdf")
            {
                <input type="search" data-search aria-label="Find in PDF" placeholder="Find in PDF…" disabled /><button type="button" data-action="find-previous" aria-label="Previous search match" disabled>↑</button><button type="button" data-action="find-next" aria-label="Next search match" disabled>↓</button><span data-matches role="status"></span>
            }
            @if (format.Kind is "text" or "document") { <button type="button" data-action="wrap">Wrap lines</button> }
            <button type="button" data-action="reload" aria-label="Reload preview" title="Reload preview"><Icon Name="refresh" Size="15" /></button>
        </div>
        <p class="preview-status" role="status" data-status>Loading preview…</p>
        <form class="preview-password" data-password-form hidden><label>PDF password<input type="password" data-password autocomplete="off" /></label><button type="submit" class="button primary">Unlock PDF</button><p class="hint">The password stays in this browser.</p></form>
        <div class="preview-surface" tabindex="0" aria-label="Preview contents">
            <div class="pdf-scroll" tabindex="0"><div class="pdfViewer"></div></div>
            <div class="image-scroll"><div class="image-stage"><img alt="Preview of @Entry.Name" /></div></div>
            <pre class="source-preview" tabindex="0"></pre>
            <div class="structured-preview" tabindex="0" aria-label="Document content"></div>
        </div>
    }
    else
    {
        <div class="preview-unavailable"><Icon Name="file" Size="38" /><p>@(format.Kind == "unsupported" ? "Preview is not available for this file type." : "This file exceeds the inline preview size limit.")</p><p>Download the original to open it in its usual program.</p></div>
    }
</section>
@code {
    [Parameter, EditorRequired] public CatalogEntry Entry { get; set; } = default!;
    [Parameter] public int? InitialPage { get; set; }
    private ElementReference element;
    private IJSObjectReference? module, viewer;
    private PreviewFormat format = new("unsupported", "", 0);
    private string revision = "", loadedRevision = "";
    private readonly SemaphoreSlim previewGate = new(1, 1);
    private bool disposed;
    protected override void OnParametersSet() { format = Formats.Preview(Entry.Name); revision = DocumentPreview.Revision(Entry); }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await previewGate.WaitAsync();
        try
        {
            if (disposed) return;
            // Original PDF/image bytes do not change when background OCR finishes. Keep the user's view.
            var extractedRevision = format.Kind is "document" or "spreadsheet" ? Entry.ExtractionVersion + "|" + Entry.TextStatus : "";
            var viewRevision = revision + "|" + InitialPage + "|" + extractedRevision;
            if (loadedRevision == viewRevision) return;
            var options = new { kind = format.Kind, page = InitialPage, url = $"/documents/{Entry.Id}/{(format.Kind == "text" ? "preview-text" : format.Kind is "document" or "spreadsheet" ? "preview-data" : format.Kind == "raster" ? "preview-image-info" : "preview")}?v={revision}", enabled = format.Kind != "unsupported" && Entry.Size <= format.Limit };
            if (viewer != null) { await viewer.InvokeVoidAsync("dispose"); await viewer.DisposeAsync(); viewer = null; }
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./document-preview.js");
            if (disposed) return;
            viewer = await module.InvokeAsync<IJSObjectReference>("attach", element, options);
            loadedRevision = viewRevision;
        }
        catch (JSDisconnectedException) { }
        finally { previewGate.Release(); }
    }
    public async ValueTask DisposeAsync()
    {
        disposed = true;
        await previewGate.WaitAsync();
        try { if (viewer != null) { await viewer.InvokeVoidAsync("dispose"); await viewer.DisposeAsync(); } if (module != null) await module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
        finally { previewGate.Release(); }
    }
}

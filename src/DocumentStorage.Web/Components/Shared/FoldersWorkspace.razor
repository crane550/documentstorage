@inject LibraryService Library
@inject ILogger<FoldersWorkspace> Logger

<div class="folders-layout" aria-busy="@busy">
    <section class="paper-panel folder-browser" aria-label="Manage folders">
        <div class="panel-title"><h2>Folder directory</h2><span>@Filtered.Count folders</span></div>
        <div class="folder-filters"><label>Find a folder<input aria-label="Find a folder" placeholder="Name or path…" @bind="query" @bind:event="oninput" @bind:after="ResetPage" /></label><label>Storage location<select aria-label="Filter folders by storage" @bind="rootFilter" @bind:after="ResetPage"><option value="@Guid.Empty">All storage</option>@foreach (var root in Overview.Roots) { <option value="@root.Id">@root.Name@(!root.IsOnline ? " (offline)" : "")</option> }</select></label></div>
        <div class="folder-directory">
        @foreach (var folder in Filtered.Skip(page * 40).Take(40))
        {
            <button @key="folder.Id" class="folder-directory-row @(folder.Id == SelectedId ? "chosen" : "")" aria-pressed="@(folder.Id == SelectedId)" @onclick="() => Select(folder.Id)"><Icon Name="@(folder.IsIntake ? "inbox" : "folder")" /><span><strong>@folder.Name</strong><small>@Label(folder)</small></span><span class="index-badge">@(Online(folder) ? folder.ParentId == null ? "Storage root" : folder.IsIntake ? "Intake" : "Folder" : "Offline")</span></button>
        }
        @if (Filtered.Count == 0) { <p class="folder-empty">No folders found. Connect storage or try another search.</p> }
        </div>
        <div class="panel-footer"><span>Folders stay in ordinary server directories.</span>@if (Filtered.Count > 40) { <div><button class="text-button" disabled="@(page == 0)" @onclick="() => page--">Previous folders</button><button class="text-button" disabled="@((page + 1) * 40 >= Filtered.Count)" @onclick="() => page++">Next folders</button></div> }</div>
    </section>
    <section class="paper-panel folder-tools" aria-label="Folder tools">
    @if (Current is { } current)
    {
        <span class="eyebrow">SELECTED FOLDER</span><h2>@current.Name</h2><p class="folder-path">@Label(current)</p>
        <div class="folder-ancestors">@foreach (var ancestor in Ancestors(current)) { <button class="text-button" @onclick="() => Select(ancestor.Id)">@ancestor.Name /</button> }</div>
        <div class="folder-tool-actions"><button class="button primary" disabled="@(!Online(current) || busy)" @onclick='() => Open("create")'>New subfolder</button><button class="button subtle" disabled="@(!Online(current) || busy || current.ParentId == null)" @onclick='() => Open("rename")'>Rename folder</button><button class="button subtle" disabled="@(!Online(current) || busy || current.ParentId == null)" @onclick='() => Open("move")'>Move folder</button><button class="text-button" @onclick="() => OpenDocuments.InvokeAsync(current.Id)">Open in Documents <Icon Name="arrow" Size="13" /></button></div>
        @if (current.ParentId == null) { <p class="help-text">This is a registered storage root. Create and organize folders inside it; its server location stays fixed.</p> }
        @if (!Online(current)) { <p class="error-text">This storage is offline. Reconnect it and rescan before making changes.</p> }
        <h3>Child folders</h3>
        @foreach (var child in Overview.Folders.Where(x => x.ParentId == current.Id).OrderBy(x => x.Name)) { <button class="folder-child text-button" @onclick="() => Select(child.Id)"><Icon Name="@(child.IsIntake ? "inbox" : "folder")" />@child.Name</button> }
        @if (!Overview.Folders.Any(x => x.ParentId == current.Id)) { <p class="help-text">No child folders yet.</p> }
        <h3>Folder instructions</h3><p class="folder-guidance">@(current.Instructions.Length > 0 ? current.Instructions : "No instructions saved here. Open in Documents to edit folder guidance or designate intake.")</p>
        <p class="help-text">Renames and moves include all contents. Document IDs, saved instructions and intake settings stay with their folders. Moves are limited to the same storage location.</p>
    }
    else { <h2>Choose a folder</h2><p>Select a folder in the directory or use its manage button in the sidebar.</p> }
    @if (notice != null) { <p role="status" class="@(failed ? "error-text" : "folder-success")">@notice</p> }
    </section>
</div>
@if (operation != null && source != null)
{
    <div class="modal-backdrop" @onkeydown="Key"><section class="modal" role="dialog" aria-modal="true" aria-labelledby="folder-dialog-title">
        <div class="modal-header"><span class="stat-icon"><Icon Name="folder" /></span><button class="icon-button" aria-label="Close folder dialog" disabled="@busy" @onclick="Close"><Icon Name="close" /></button></div>
        <h2 id="folder-dialog-title">@(operation == "create" ? "Create a subfolder" : operation == "rename" ? "Rename folder" : "Move folder")</h2>
        <p class="modal-description">@(operation == "create" ? "A real folder will be created inside the selected folder." : "All contents move together. Existing files and folders are never overwritten.")</p>
        <form @onsubmit="Save" @onsubmit:preventDefault>
            @if (operation != "move") { <label for="folder-name">Folder name</label><input id="folder-name" required maxlength="180" @bind="name" @bind:event="oninput" /> }
            @if (operation == "move")
            {
                <label for="folder-destination-search">Find destination</label><input id="folder-destination-search" @bind="destinationQuery" @bind:event="oninput" placeholder="Filter destination folders…" />
                <label for="folder-destination">Destination folder</label><select id="folder-destination" required @bind="destination"><option value="@Guid.Empty">Choose a destination</option>@foreach (var target in Destinations) { <option value="@target.Id">@Label(target)</option> }</select>
                <p class="field-hint">The current parent, this folder and its descendants are excluded. Folder name: @source.Name</p>
            }
            <div class="folder-change-preview"><strong>@(operation == "create" ? "Create" : "From")</strong><span>@Label(source)</span><strong>@(operation == "create" ? "New folder" : "To")</strong><span>@Preview</span></div>
            @if (dialogError != null) { <p role="alert" class="dialog-error">@dialogError</p> }
            <div class="modal-footer"><button type="button" class="button subtle" disabled="@busy" @onclick="Close">Cancel</button><button class="button primary" type="submit" disabled="@(busy || (operation == "move" && destination == Guid.Empty))">@(busy ? "Working…" : operation == "create" ? "Create subfolder" : operation == "rename" ? "Save folder name" : "Move this folder")</button></div>
        </form>
    </section></div>
}
@code {
    [Parameter, EditorRequired] public LibraryOverview Overview { get; set; } = default!;
    [Parameter] public Guid? SelectedId { get; set; }
    [Parameter] public EventCallback<Guid> Selected { get; set; }
    [Parameter] public EventCallback<Guid> OpenDocuments { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    private string query = "", destinationQuery = "", name = "";
    private string? operation, notice, dialogError;
    private Guid rootFilter, destination;
    private int page;
    private bool busy, failed;
    private CatalogEntry? source;
    private List<CatalogEntry> snapshot = [];
    private CatalogEntry? Current => Overview.Folders.FirstOrDefault(x => x.Id == SelectedId);
    private bool Online(CatalogEntry folder) => Overview.Roots.Any(x => x.Id == folder.RootId && x.IsOnline);
    private string Label(CatalogEntry folder) => (Overview.Roots.FirstOrDefault(x => x.Id == folder.RootId)?.Name ?? "Storage") + (folder.RelativePath.Length > 0 ? " / " + folder.RelativePath : " / (root)");
    private List<CatalogEntry> Filtered => Overview.Folders.Where(x => (rootFilter == Guid.Empty || x.RootId == rootFilter) && Label(x).Contains(query, StringComparison.OrdinalIgnoreCase)).OrderBy(x => Label(x), StringComparer.OrdinalIgnoreCase).ToList();
    private IEnumerable<CatalogEntry> Destinations => snapshot.Where(x => source != null && x.RootId == source.RootId && x.Id != source.Id && x.Id != source.ParentId && !x.RelativePath.StartsWith(source.RelativePath + "/", StringComparison.Ordinal) && (x.Id == destination || Label(x).Contains(destinationQuery, StringComparison.OrdinalIgnoreCase))).OrderBy(x => Label(x), StringComparer.OrdinalIgnoreCase);
    private string Preview => source == null ? "" : operation == "create" ? Label(source) + "/" + name : operation == "rename" ? Label(source) [..(Label(source).Length - source.Name.Length)] + name : snapshot.FirstOrDefault(x => x.Id == destination) is { } target ? Label(target) + "/" + source.Name : "Choose a destination";
    private IEnumerable<CatalogEntry> Ancestors(CatalogEntry folder) { var list = new List<CatalogEntry>(); var next = Overview.Folders.FirstOrDefault(x => x.Id == folder.ParentId); while (next != null) { list.Insert(0, next); next = Overview.Folders.FirstOrDefault(x => x.Id == next.ParentId); } return list; }
    private void ResetPage() => page = 0;
    private async Task Select(Guid id) { if (!busy) { notice = null; await Selected.InvokeAsync(id); } }
    private void Open(string kind) { if (busy || Current == null) return; operation = kind; source = Current; snapshot = Overview.Folders.ToList(); name = kind == "create" ? "" : source.Name; destination = Guid.Empty; destinationQuery = ""; dialogError = null; }
    private void Close() { if (!busy) operation = null; }
    private void Key(KeyboardEventArgs e) { if (e.Key == "Escape") Close(); }
    private async Task Save()
    {
        if (busy || source == null) return;
        busy = true; failed = false;
        try
        {
            Guid selectedId = source.Id;
            if (operation == "create") selectedId = await Library.CreateFolderAsync(source.Id, name, source.RelativePath);
            else
            {
                var parent = snapshot.SingleOrDefault(x => x.Id == (operation == "rename" ? source.ParentId : destination)) ?? throw new StorageException("Choose a destination folder.");
                await Library.MoveAsync(source.Id, parent.Id, operation == "rename" ? name : source.Name, source.RelativePath, parent.RelativePath);
            }
            await Changed.InvokeAsync(); await Selected.InvokeAsync(selectedId); operation = null; notice = "Folder changes saved. The directory and sidebar are up to date.";
        }
        catch (Exception ex) { Logger.LogWarning("Folder operation failed: {Kind}", ex.GetType().Name); dialogError = ex is StorageException ? ex.Message : "The change could not finish. Check storage and refresh before trying again."; failed = true; }
        finally { busy = false; }
    }
}

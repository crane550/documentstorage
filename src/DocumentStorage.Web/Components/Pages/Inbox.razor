@page "/"
@page "/inbox"
@attribute [Authorize(Roles = IdentitySetup.Administrator)]
@implements IAsyncDisposable
@inject LibraryService Library
@inject WorkspaceState Workspace
@inject NavigationManager Navigation
@inject ILogger<Inbox> Logger

<PageTitle>Inbox · @Workspace.DisplayName</PageTitle>

<header class="page-head inbox-head">
    <div class="head-title">
        <h1>Inbox</h1>
        @if (loaded && SetUp)
        {
            <nav class="inbox-tabs" aria-label="Inbox views">
                <button type="button" class="@(view == "waiting" ? "active" : "")" aria-pressed="@(view == "waiting" ? "true" : "false")" @onclick="ShowWaiting">Waiting<span class="count">@queue.Total</span></button>
                <button type="button" class="@(view == "filed" ? "active" : "")" aria-pressed="@(view == "filed" ? "true" : "false")" @onclick="ShowFiled">Filed</button>
            </nav>
        }
    </div>
    @if (loaded && SetUp) { <a class="text-button" href="/kinds"><Icon Name="signpost" Size="14" />Kinds, senders and tags</a> }
</header>

<AssistantChangeList />

@if (proposals.Count > 0)
{
    <section class="waiting" aria-label="Suggestions waiting for you">
        <h2 class="section-label"><Icon Name="plug" Size="15" />From your assistants</h2>
        <div class="waiting-list">
            @foreach (var item in proposals)
            {
                <button class="waiting-card" @key="item.Id" @onclick="() => reviewing = item"><span class="waiting-icon"><Icon Name="@ProposalDialog.KindIcon(item.Kind)" Size="17" /></span><span><strong>@ProposalDialog.Name(item)</strong><small>@ConnectionName(item.ConnectionId) · @WorkspaceState.Ago(item.CreatedAt)</small></span><span class="waiting-go">Review<Icon Name="arrow" Size="13" /></span></button>
            }
        </div>
    </section>
}

@if (!loaded) { <div class="loading-sheet" aria-busy="true"></div> }
else if (!SetUp)
{
    <section class="setup sheet">
        <h2>Three steps to a self-sorting inbox</h2>
        <ol class="steps">
            <li class="@(HasStorage ? "done" : "current")">
                <span class="step-mark">@if (HasStorage) { <Icon Name="check" Size="15" Stroke="2.4" /> } else { <span>1</span> }</span>
                <div><h3>Connect your storage</h3><p>A folder on the server or a NAS share. Files stay where they are.</p>
                    @if (!HasStorage) { <button class="button primary" @onclick="() => connecting = true"><Icon Name="drive" Size="16" />Connect storage</button> }
                </div>
            </li>
            <li class="@(!HasStorage ? "todo" : "current")">
                <span class="step-mark"><span>2</span></span>
                <div><h3>Pick the folder new scans land in</h3><p>Point your scanner here. Everything that arrives waits in this inbox.</p>
                    @if (HasStorage)
                    {
                        <div class="step-choices">
                            @foreach (var root in Workspace.Overview.Roots.Where(x => x.IsOnline))
                            {
                                if (Workspace.RootFolder(root.Id) is { } top) { <button class="button primary" disabled="@busy" @onclick="() => CreateInbox(top)"><Icon Name="folder-plus" Size="16" />Create “Inbox” in @root.Name</button> }
                            }
                            @if (Candidates.Any())
                            {
                                <label class="sr-only" for="setup-inbox">Use an existing folder</label>
                                <select id="setup-inbox" @bind="chosenInbox"><option value="@Guid.Empty">…or use an existing folder</option>@foreach (var folder in Candidates) { <option value="@folder.Id">@Workspace.FolderLabel(folder)</option> }</select>
                                <button class="button" disabled="@(busy || chosenInbox == Guid.Empty)" @onclick="UseChosen">Use as inbox</button>
                            }
                        </div>
                    }
                </div>
            </li>
            <li class="todo">
                <span class="step-mark"><span>3</span></span>
                <div><h3>File the first one</h3><p>The reader says what it is, who it's from and its date; Stash works out the folder and name. Correct anything with a click and approve. Once a kind gets it right every time, let it file itself.</p></div>
            </li>
        </ol>
    </section>
}
else
{
    @if (nudges.Count > 0)
    {
        <section class="sheet nudges" aria-label="Regulars ready to file themselves">
            @foreach (var regular in nudges)
            {
                <div class="nudge" @key="regular.Id">
                    <Icon Name="check-circle" Size="16" />
                    <span><strong>@regular.Kind from @regular.Sender</strong> has been right @regular.Streak times in a row. Let these file themselves?</span>
                    <button type="button" class="button small primary" disabled="@busy" @onclick="() => Trust(regular)">Let them file themselves</button>
                    <button type="button" class="text-button" disabled="@busy" @onclick="() => Snooze(regular)">Not now</button>
                </div>
            }
        </section>
    }
    @if (view == "filed")
    {
        <section class="sheet filed-list" aria-label="Recently filed">
            @if (filed.Count == 0) { <p class="hint">Nothing filed yet. Approved documents show here, with Undo.</p> }
            <ul>
                @foreach (var item in filed)
                {
                    <li @key="item.PlanId" class="filed-row">
                        <span class="file-badge" data-ext="@WorkspaceState.Extension(item.FileName)"><Icon Name="file" Size="16" /></span>
                        <div class="filed-text">
                            <strong>@item.FileName</strong>
                            <small>@item.Kind@(item.From.Length > 0 ? " · " + item.From : "")@(item.Date is DateOnly d ? " · " + d.ToString("MMM d, yyyy") : "") · @WorkspaceState.Ago(item.FiledAt)</small>
                            <small class="mono">@item.DestinationPath</small>
                        </div>
                        @if (item.Automatic) { <Stamp Text="Filed itself" Tone="working" /> } else if (item.Corrected) { <Stamp Text="Corrected" Tone="attention" /> }
                        @if (item.Automatic && !item.Confirmed) { <button type="button" class="text-button" disabled="@busy" @onclick="() => Confirm(item)">Looks right</button> }
                        else if (item.Automatic) { <span class="hint">Confirmed</span> }
                        <a class="text-button" href="@($"/library?doc={item.EntryId}")">Open</a>
                        <button type="button" class="button small" disabled="@busy" @onclick="() => Undo(item)">Undo</button>
                    </li>
                }
            </ul>
        </section>
    }
    else if (queue.Total == 0)
    {
        <section class="caught-up">
            <div class="tray-art" aria-hidden="true"><Icon Name="inbox" Size="54" Stroke="1.2" /></div>
            <h2>All caught up</h2>
            <p>New scans in @string.Join(", ", Workspace.InboxFolders.Select(x => Workspace.FolderLabel(x))) show up here. You can also drop files anywhere on this page.</p>
            @if (!Workspace.ReaderEnabled) { <p class="hint"><Icon Name="spark" Size="14" /><a href="/settings?tab=reader">Connect an AI reader</a> to have documents read and filled in for you.</p> }
        </section>
    }
    else
    {
        <div class="inbox @(selected != null ? "has-selection" : "")" data-sort-inbox>
            <section class="tray" aria-label="Inbox documents">
                <header class="tray-head sort-tray-head">
                    <button type="button" class="icon-button small tray-toggle" data-tray-toggle aria-label="Show or hide the list" title="Show or hide the list"><Icon Name="arrow-left" Size="15" /></button>
                    <span class="tray-folded-count" aria-hidden="true">@queue.Total</span><span class="tray-title">@queue.Total @(queue.Total == 1 ? "document" : "documents")<span class="tray-summary">@Summary</span></span>
                    @if (checkedIds.Count > 0) { <button type="button" class="button small primary" disabled="@busy" @onclick="ApproveChecked">Approve @checkedIds.Count</button> }
                    else if (SureCount > 0) { <button type="button" class="button small" disabled="@busy" @onclick="ApproveSure" title="File every card the reader is sure of, as suggested">Approve @SureCount sure</button> }
                </header>
                <ul class="tray-list">
                    @foreach (var card in queue.Cards)
                    {
                        var status = StatusOf(card);
                        <li @key="card.Document.Id" class="sort-row @(selected?.Document.Id == card.Document.Id ? "selected" : "")">
                            <input type="checkbox" class="sort-check" aria-label="@($"Select {card.Document.Name}")" checked="@checkedIds.Contains(card.Document.Id)" disabled="@(card.Plan.Problem != null)" @onchange="e => Toggle(card, (bool)e.Value!)" />
                            <button type="button" class="intake-item @(selected?.Document.Id == card.Document.Id ? "selected" : "")" aria-current="@(selected?.Document.Id == card.Document.Id ? "true" : null)" @onclick="() => Select(card)">
                                <span class="item-text">
                                    <strong>@card.Document.Name</strong>
                                    @if (card.Choice.Kind.Length > 0) { <small class="sort-summary">@card.Choice.Kind@(card.Choice.From.Length > 0 ? " · " + card.Choice.From : "")@(card.Choice.Date is DateOnly d ? " · " + d.ToString("MMM d, yyyy") : "")</small> }
                                    else { <small>@WorkspaceState.Ago(card.Document.ObservedAt) · @WorkspaceState.FormatSize(card.Document.Size)</small> }
                                    @if (card.Plan.Problem == null && card.Choice.Kind.Length > 0) { <small class="sort-goes mono" title="@card.Plan.DestinationPath">→ @FolderTail(card.Plan.FolderPath)</small> }
                                </span>
                                <Stamp Text="@status.Text" Tone="@status.Tone" />
                            </button>
                        </li>
                    }
                </ul>
                @if (queue.Total > PageSize) { <footer class="tray-pager"><button class="text-button" disabled="@(offset == 0)" @onclick="Previous">Previous</button><span>@(offset + 1)–@(offset + queue.Cards.Count) of @queue.Total</span><button class="text-button" disabled="@(offset + PageSize >= queue.Total)" @onclick="Next">Next</button></footer> }
                <footer class="tray-keys hint"><kbd>J</kbd><kbd>K</kbd> next / previous · <kbd>Enter</kbd> approve</footer>
            </section>
            @if (selected != null)
            {
                <div class="inbox-preview"><DocumentPreviewPanel Entry="PreviewEntry(selected)" @key="selected.Document.Id" /></div>
                <div class="inbox-split" role="separator" aria-orientation="vertical" aria-label="Drag to resize the preview and the slip" title="Drag to resize · double-click to even out" tabindex="0" data-inbox-split></div>
                <SortSlip @key="selected.Document.Id" Card="selected" Vocabulary="vocabulary" Filed="Filed" ReadingChanged="ReloadSelected" Skip="SelectNext"
                          RequestMove="RequestMove" RequestDelete="RequestDelete" RequestRescan="Rescan" VocabularyChanged="ReloadVocabulary" />
            }
            <button type="button" hidden data-sort-next @onclick="SelectNext"></button>
            <button type="button" hidden data-sort-previous @onclick="SelectPrevious"></button>
        </div>
    }
}

@if (connecting) { <ConnectStorageDialog OnClose="() => connecting = false" OnConnected="Connected" /> }
@if (moving != null) { <EntryDialog Mode="move" Entry="moving" OnClose="() => moving = null" OnDone="Moved" /> }
@if (deleting != null) { <EntryDialog Mode="trash" Entry="deleting" OnClose="() => deleting = null" OnDone="Deleted" /> }
@if (reviewing != null) { <ProposalDialog Proposal="reviewing" Source="@ConnectionName(reviewing.ConnectionId)" Types="types" OnClose="() => reviewing = null" OnDecided="Decided" /> }

@code {
    private const int PageSize = 50;
    [SupplyParameterFromQuery(Name = "open")] public string? Open { get; set; }
    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }
    [Inject] private IJSRuntime JS { get; set; } = default!;
    private SortInbox queue = new([], 0);
    private SortCard? selected;
    private SortVocabulary vocabulary = new([], [], [], [], [], []);
    private List<FiledItem> filed = [];
    private List<RegularView> nudges = [];
    private readonly HashSet<Guid> checkedIds = [];
    private List<DocumentTypeProfile> types = [];
    private List<AssistantProposal> proposals = [];
    private List<AssistantConnection> connections = [];
    private AssistantProposal? reviewing;
    private CatalogEntry? moving;
    private CatalogEntry? deleting;
    private string? handledOpen;
    private string view = "waiting";
    private Guid chosenInbox;
    private bool loaded, busy, connecting;
    private int offset;
    private readonly CancellationTokenSource lifetime = new();
    private Task? polling;
    private IJSObjectReference? keys, layout;
    // The end of a path says the most: "…/Cedar Bank/2026".
    private static string FolderTail(string path)
    {
        var parts = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length <= 2 ? path : "…/" + string.Join("/", parts[^2..]);
    }
    private bool HasStorage => Workspace.Overview.Roots.Count > 0;
    private bool SetUp => HasStorage && Workspace.InboxFolders.Count > 0;
    private int SureCount => queue.Cards.Count(x => x.Sure && x.Plan.Problem == null);
    private IEnumerable<CatalogEntry> Candidates => Workspace.Overview.Folders.Where(x => x.ParentId != null && Workspace.IsWritable(x.RootId)).OrderBy(x => Workspace.FolderLabel(x)).Take(200);
    private string Summary
    {
        get
        {
            var sure = SureCount;
            var reading = queue.Cards.Count(x => x.ReaderState is "Waiting to be read" or "Reading" or "Will try again");
            var parts = new List<string>();
            if (sure > 0) parts.Add($"{sure} sure");
            if (reading > 0) parts.Add($"{reading} being read");
            var rest = queue.Cards.Count - sure - reading;
            if (rest > 0) parts.Add($"{rest} need a look");
            return string.Join(" · ", parts);
        }
    }
    [Inject] private IServiceScopeFactory Scopes { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await Workspace.EnsureLoadedAsync();
        view = View == "filed" ? "filed" : "waiting";
        var saved = await Library.InboxPositionAsync(await Workspace.ActorAsync(), Guid.TryParse(Open, out var open) ? open : null);
        offset = saved.Offset / PageSize * PageSize;
        await RefreshAsync();
        if (queue.Cards.FirstOrDefault(x => x.Document.Id == saved.EntryId) is { } wanted) await Select(wanted);
        else if (queue.Cards.Count > 0) await Select(queue.Cards[0]);
        handledOpen = Open;
        loaded = true;
        Workspace.Changed += WorkspaceChanged;
        polling = PollAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The split and the folded list are remembered on this device; they go back on whenever the grid is drawn.
        if (!firstRender) { if (layout != null) try { await layout.InvokeVoidAsync("apply"); } catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException) { } return; }
        try
        {
            keys = await JS.InvokeAsync<IJSObjectReference>("import", "./sort-keys.js"); await keys.InvokeVoidAsync("attach");
            layout = await JS.InvokeAsync<IJSObjectReference>("import", "./inbox-layout.js"); await layout.InvokeVoidAsync("attach");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException) { }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!loaded || handledOpen == Open) return;
        handledOpen = Open;
        if (!Guid.TryParse(Open, out var id)) return;
        var position = await Library.InboxPositionAsync(await Workspace.ActorAsync(), id);
        offset = position.Offset / PageSize * PageSize; selected = null;
        await RefreshAsync();
        if (queue.Cards.FirstOrDefault(x => x.Document.Id == id) is { } wanted) await Select(wanted);
    }

    public async Task RefreshAsync()
    {
        try
        {
            queue = await Library.SortInboxAsync(offset, PageSize);
            if (offset > 0 && queue.Cards.Count == 0)
            {
                offset = Math.Max(0, (queue.Total - 1) / PageSize * PageSize);
                queue = await Library.SortInboxAsync(offset, PageSize);
            }
            vocabulary = await Library.SortVocabularyAsync();
            nudges = (await Library.RegularsAsync()).Where(x => x.Suggest).Take(3).ToList();
            checkedIds.IntersectWith(queue.Cards.Where(x => x.Plan.Problem == null).Select(x => x.Document.Id));
            if (view == "filed") filed = await Library.RecentFilingsAsync(100);
            types = (await Library.IdentificationOverviewAsync()).Types;
            var actor = await Workspace.ActorAsync();
            proposals = (await Library.AssistantChangesAsync(actor)).Proposals.Where(x => x.State == "Pending").ToList();
            if (proposals.Any(x => x.ConnectionId != null))
            {
                await using var scope = Scopes.CreateAsyncScope();
                connections = await scope.ServiceProvider.GetRequiredService<DocumentStorage.Web.Mcp.AssistantConnections>().ListAsync(actor);
            }
            if (selected != null) selected = queue.Cards.FirstOrDefault(x => x.Document.Id == selected.Document.Id) ?? selected;
        }
        catch (Exception ex) { Logger.LogError(ex, "Inbox refresh failed"); Workspace.Notify("The inbox could not refresh. Check storage and try again.", true); }
    }

    private static (string Text, string Tone) StatusOf(SortCard card)
    {
        if (!card.Document.Online) return ("Offline", "muted");
        if (card.Document.Readiness != "Ready") return ("Arriving", "muted");
        if (card.ReaderState is "Waiting to be read" or "Will try again") return ("Queued", "muted");
        if (card.ReaderState == "Reading") return ("Reading", "working");
        if (card.Duplicate) return ("Duplicate", "danger");
        if (card.Plan.Problem != null) return (card.Choice.Kind.Length == 0 ? "Needs a kind" : "Needs a look", "attention");
        if (card.Sure) return ("Sure", "ready");
        if (card.Sources.ContainsValue("person")) return ("Ready", "ready");
        return ("Check", "new");
    }

    private static CatalogEntry PreviewEntry(SortCard card) => new() { Id = card.Document.Id, Name = card.Document.Name, Size = card.Document.Size, RootId = card.Document.RootId, RelativePath = card.Document.RelativePath, ModifiedAt = card.Document.ModifiedAt };

    private async Task Select(SortCard card)
    {
        selected = card;
        await Library.SaveInboxPositionAsync(await Workspace.ActorAsync(), card.Document.Id, offset);
        if (loaded)
        {
            handledOpen = card.Document.Id.ToString();
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("open", handledOpen), replace: true);
        }
    }
    private async Task SelectNext() => await Step(1);
    private async Task SelectPrevious() => await Step(-1);
    private async Task Step(int by)
    {
        if (queue.Cards.Count == 0) return;
        var index = selected == null ? -1 : queue.Cards.FindIndex(x => x.Document.Id == selected.Document.Id);
        await Select(queue.Cards[Math.Clamp(index + by, 0, queue.Cards.Count - 1)]);
    }
    private async Task ReloadSelected()
    {
        if (selected == null) return;
        var id = selected.Document.Id;
        var card = await Library.SortCardAsync(id);
        if (card != null && selected?.Document.Id == id)
        {
            selected = card;
            var index = queue.Cards.FindIndex(x => x.Document.Id == id);
            if (index >= 0) queue.Cards[index] = card;
        }
    }
    private async Task PollAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(4));
            var tick = 0;
            while (await timer.WaitForNextTickAsync(lifetime.Token))
                await InvokeAsync(async () =>
                {
                    if (busy || view != "waiting") return;
                    // The selected card often; the whole list every so often, so readings finished in the background show up.
                    if (++tick % 4 == 0 && queue.Cards.Any(x => x.ReaderState is "Waiting to be read" or "Reading" or "Will try again" || x.Document.TextStatus is "Text queued" or "Extracting" or "OCR tool unavailable" or "PDF text tool unavailable" or "PDF OCR tools unavailable")) await RefreshAsync();
                    else if (selected?.ReaderState is "Waiting to be read" or "Reading" or "Will try again" || selected?.Document.TextStatus is "Text queued" or "Extracting" or "OCR tool unavailable" or "PDF text tool unavailable" or "PDF OCR tools unavailable") await ReloadSelected();
                    else return;
                    StateHasChanged();
                });
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex) { Logger.LogWarning("Reader status refresh stopped: {Kind}", ex.GetType().Name); }
    }
    private void WorkspaceChanged() => InvokeAsync(async () => { if (!busy && moving == null && deleting == null) { await RefreshAsync(); StateHasChanged(); } });

    private void Toggle(SortCard card, bool on) { if (on) checkedIds.Add(card.Document.Id); else checkedIds.Remove(card.Document.Id); }

    private async Task ApproveChecked() => await ApproveMany(queue.Cards.Where(x => checkedIds.Contains(x.Document.Id)).ToList());
    private async Task ApproveSure() => await ApproveMany(queue.Cards.Where(x => x.Sure && x.Plan.Problem == null).ToList());
    private async Task ApproveMany(List<SortCard> cards) => await Run(async () =>
    {
        var actor = await Workspace.ActorAsync(); var done = 0; var failed = new List<string>();
        // A copy of something already in Stash is filed only from its own slip, after Keep both.
        var copies = cards.Count(x => x.Duplicate);
        if (copies > 0) failed.Add($"{copies} {(copies == 1 ? "is a copy" : "are copies")} of documents already in Stash; open {(copies == 1 ? "it" : "each")} to decide");
        foreach (var card in cards.Where(x => !x.Duplicate))
        {
            try { await Library.FileSortedAsync(card.Document.Id, card.Choice, card.Document.ContentHash, actor); done++; }
            catch (StorageException ex) { failed.Add(card.Document.Name + ": " + ex.Message); }
        }
        checkedIds.Clear();
        await AfterFiling(cards.Select(x => x.Document.Id).ToHashSet());
        Workspace.Notify(failed.Count == 0 ? $"Filed {done} {(done == 1 ? "document" : "documents")}." : $"Filed {done}. Not filed: {string.Join("; ", failed.Take(3))}{(failed.Count > 3 ? "…" : "")}", failed.Count > 0);
    });

    private async Task AfterFiling(HashSet<Guid> gone)
    {
        // Move straight on to the next document in the pile.
        // Stay where you were in the whole pile, not just on this page.
        var position = offset + (selected == null ? 0 : Math.Max(0, queue.Cards.FindIndex(x => x.Document.Id == selected.Document.Id)));
        var keep = selected != null && !gone.Contains(selected.Document.Id) ? selected.Document.Id : (Guid?)null;
        selected = null; moving = null; deleting = null;
        await Workspace.RefreshAsync(); await RefreshAsync();
        if (keep is Guid id && queue.Cards.FirstOrDefault(x => x.Document.Id == id) is { } still) await Select(still);
        else if (queue.Cards.Count > 0) await Select(queue.Cards[Math.Clamp(position - offset, 0, queue.Cards.Count - 1)]);
        else await Library.SaveInboxPositionAsync(await Workspace.ActorAsync(), null, offset);
    }

    private async Task Filed(string message) => await Run(async () =>
    {
        await AfterFiling(selected == null ? [] : [selected.Document.Id]);
        Workspace.Notify(message);
    });
    private async Task Undo(FiledItem item) => await Run(async () =>
    {
        await Library.UndoFilingAsync(item.PlanId, await Workspace.ActorAsync());
        await Workspace.RefreshAsync(); await RefreshAsync();
        Workspace.Notify(item.Automatic ? $"{item.FileName} is back in the inbox. {item.Kind} will ask before filing again." : $"{item.FileName} is back in the inbox.");
    });
    private async Task ReloadVocabulary() { vocabulary = await Library.SortVocabularyAsync(); StateHasChanged(); }
    private async Task Confirm(FiledItem item) => await Run(async () => { await Library.ConfirmFilingAsync(item.PlanId, await Workspace.ActorAsync()); await RefreshAsync(); });
    private async Task Trust(RegularView regular) => await Run(async () =>
    {
        await Library.SetRegularAutoFileAsync(regular.Id, true, await Workspace.ActorAsync()); await RefreshAsync();
        Workspace.Notify($"{regular.Kind} from {regular.Sender} will now file itself when Stash is sure. You'll see them under Filed, with Undo.");
    });
    private async Task Snooze(RegularView regular) => await Run(async () => { await Library.SnoozeRegularAsync(regular.Id, await Workspace.ActorAsync()); await RefreshAsync(); });
    private async Task ShowWaiting() { view = "waiting"; Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("view", (string?)null), replace: true); await RefreshAsync(); }
    private async Task ShowFiled() { view = "filed"; Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("view", "filed"), replace: true); await RefreshAsync(); }
    private async Task RequestMove(Guid id) => moving = await Library.EntryAsync(id);
    private async Task RequestDelete(Guid id) => deleting = await Library.EntryAsync(id);
    private Task Moved(Guid _) => Filed("Document moved.");
    private Task Deleted(Guid _) => Filed("Document moved to Trash. You can restore it from History → Trash.");
    private async Task Rescan(Guid id) => await Run(async () =>
    {
        var entry = await Library.EntryAsync(id) ?? throw new StorageException("That document is no longer in the catalog.");
        var result = await Library.RescanDocumentAsync(entry.Id, await Workspace.ActorAsync(), entry.RelativePath);
        await RefreshAsync(); await ReloadSelected();
        Workspace.Notify(result.TextStatus == "Indexed" && result.Characters > 0
            ? $"Text rescanned: {result.Characters:N0} characters. Read it again with AI for a fresh suggestion."
            : result.TextStatus is "Text queued" or "Extracting" ? "Text extraction queued. The document will update when it finishes; Read again with AI requests a fresh interpretation."
            : result.Readiness != "Ready" ? "The file is still arriving. Wait a few seconds, then rescan text again."
            : result.TextStatus == "No text found" ? "Text extraction finished, but no readable words were found. Check the original scan."
            : "Rescan finished: " + result.TextStatus + ".", result.TextStatus is not ("Indexed" or "Text queued" or "Extracting"));
    });
    private async Task Decided(string message) { reviewing = null; await RefreshAsync(); Workspace.Notify(message); }
    private async Task Connected(Guid rootId) { connecting = false; await Workspace.RefreshAsync(); Workspace.Notify("Storage connected. Now pick the folder new scans land in."); }
    private async Task CreateInbox(CatalogEntry top) => await Run(async () =>
    {
        var id = Workspace.Overview.Folders.FirstOrDefault(x => x.ParentId == top.Id && string.Equals(x.Name, "Inbox", StringComparison.OrdinalIgnoreCase))?.Id
            ?? await Library.CreateFolderAsync(top.Id, "Inbox", top.RelativePath);
        await Library.SetIntakeAsync(id, true);
        await Workspace.RefreshAsync(); await RefreshAsync();
        Workspace.Notify("Inbox ready. Point your scanner at " + Workspace.FolderLabel(id) + ".");
    });
    private async Task UseChosen() => await Run(async () =>
    {
        await Library.SetIntakeAsync(chosenInbox, true);
        await Workspace.RefreshAsync(); await RefreshAsync();
        Workspace.Notify("Inbox ready.");
    });
    private async Task Run(Func<Task> action)
    {
        if (busy) return; busy = true;
        try { await action(); }
        catch (Exception ex) { Logger.LogError(ex, "Inbox action failed"); Workspace.Notify(ex is StorageException ? ex.Message : "That could not finish. Check storage and try again.", true); }
        finally { busy = false; }
    }
    private string ConnectionName(Guid? id) => id == null ? "the reader" : connections.FirstOrDefault(x => x.Id == id)?.Name ?? "an assistant";
    private async Task Previous() => await Page(Math.Max(0, offset - PageSize));
    private async Task Next() => await Page(offset + PageSize);
    private async Task Page(int value) { offset = value; selected = null; await RefreshAsync(); if (queue.Cards.Count > 0) await Select(queue.Cards[0]); }
    public async ValueTask DisposeAsync()
    {
        Workspace.Changed -= WorkspaceChanged;
        lifetime.Cancel(); if (polling != null) await polling; lifetime.Dispose();
        if (keys != null) { try { await keys.InvokeVoidAsync("detach"); await keys.DisposeAsync(); } catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException) { } }
        if (layout != null) { try { await layout.DisposeAsync(); } catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException) { } }
    }
}

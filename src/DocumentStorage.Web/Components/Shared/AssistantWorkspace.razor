@inject LibraryService Library
@inject IServiceScopeFactory Scopes
@inject AuthenticationStateProvider Authentication
@inject DocumentStorage.Web.Mcp.McpAddress Address
@inject ILogger<AssistantWorkspace> Logger
@using DocumentStorage.Web.Mcp
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.EntityFrameworkCore

<section class="intake-intro paper-panel"><span class="stat-icon sage"><Icon Name="spark" Size="25" /></span><div><h2>A careful connection to your assistants.</h2><p>Connect Claude, ChatGPT or another OAuth-capable MCP client. Review proposed instructions and rules here. Filing approvals describe one exact move and expire in 15 minutes.</p></div><button class="button subtle" disabled="@busy" @onclick="Refresh">Refresh assistant activity</button></section>
@if (message != null) { <div class="notice @(error ? "error" : "success")" role="status">@message</div> }
<div class="ai-layout">
    <section class="paper-panel rule-editor"><div class="eyebrow">NEW MCP CONNECTION</div><h2>Give each assistant its own key.</h2>
        <p class="field-hint">MCP server: <code>@Address.Resource</code></p>
        <div class="workflow-form"><label for="connection-name">Connection name</label><input id="connection-name" @bind="name" maxlength="80" placeholder="My Claude connector" />
            <label for="connection-callbacks">OAuth callback URLs</label><textarea id="connection-callbacks" @bind="callbacks" rows="3" placeholder="Paste the exact callback URL provided by your MCP client. One URL per line."></textarea>
            <p class="field-hint">Use the callback supplied by the client. All permissions cover the complete library. Context and folder names are always readable.</p>
            <label class="workflow-checkbox"><input type="checkbox" @bind="readDocuments" />Read indexed document text and reviewed facts</label>
            <label class="workflow-checkbox"><input type="checkbox" @bind="proposeInstructions" />Propose instructions for browser review</label>
            <label class="workflow-checkbox"><input type="checkbox" @bind="proposeRules" />Propose paused filing rules for browser review</label>
            <label class="workflow-checkbox"><input type="checkbox" @bind="execute" />Request and execute individually approved filing moves</label>
            <details class="review-text"><summary>Desktop client options</summary><label class="workflow-checkbox"><input type="checkbox" @bind="publicClient" />Public client with PKCE and no client secret</label><p class="field-hint">Leave this off when your client asks for an OAuth client ID and secret. All clients must use S256 PKCE.</p></details>
            <button class="button primary" disabled="@busy" @onclick="Register">Create MCP connection</button>
        </div>
        @if (registered != null)
        { <div class="ai-proposal secret-panel"><h3>Copy your connection details.</h3><label for="new-client-id">OAuth client ID</label><textarea id="new-client-id" readonly rows="2">@registered.Connection.ClientId</textarea>@if (registered.Secret != null) { <label for="new-client-secret">OAuth client secret · shown once</label><textarea id="new-client-secret" readonly rows="3">@registered.Secret</textarea> }<p>Store the secret in your MCP client's private settings. The app stores its hash and cannot show it again.</p><button class="text-button" @onclick="() => registered = null">Hide connection details</button></div> }
    </section>
    <section class="paper-panel rule-editor"><div class="eyebrow">REGISTERED CONNECTIONS</div><h2>Control who can connect.</h2>
        @foreach (var connection in connections) { <div class="connection-row"><strong>@connection.Name</strong><span class="index-badge">@(connection.RevokedAt == null ? "Active" : "Revoked")</span><code>@connection.ClientId</code><p>@string.Join(", ", JsonSerializer.Deserialize<string[]>(connection.ScopesJson)!)</p>@if (connection.RevokedAt == null) { <button class="text-button" disabled="@busy" @onclick="() => Revoke(connection.Id)">Revoke connection</button> }</div> }
        @if (connections.Count == 0) { <p class="field-hint">No assistant has access yet. Create a separate connection for each client so it can be revoked independently.</p> }
    </section>
</div>
<section class="paper-panel ai-jobs"><div class="panel-title"><h2>Proposed changes</h2><span>Latest 50 · no change until you accept</span></div>
    @foreach (var item in changes.Proposals) { <button class="rule-list-item @(selected?.Id == item.Id ? "selected" : "")" @onclick="() => Select(item)" disabled="@busy"><span><strong>@ProposalName(item)</strong><small>@ConnectionName(item.ConnectionId) · @item.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</small></span><span class="index-badge @(item.State is "Applied" or "Executed" ? "indexed" : "")">@item.State</span></button> }
    @if (changes.Proposals.Count == 0) { <div class="empty-state"><h2>No proposed changes yet</h2><p>Instruction conversations and connected assistants will leave their proposals here.</p></div> }
</section>
@if (selected != null)
{
    <section class="paper-panel rule-editor proposal-details"><div class="eyebrow">REVIEW PROPOSED CHANGE · @selected.State</div><h2>@ProposalName(selected)</h2>
        @if (selected.Kind == "Guidance") { var change = JsonSerializer.Deserialize<GuidanceChange>(selected.PayloadJson)!; <p>@change.Explanation</p><div class="ai-layout"><div><h3>Current instructions</h3><pre class="instruction-canonical">@currentGuidance</pre></div><div><h3>Proposed instructions</h3><pre class="instruction-canonical">@change.Text</pre></div></div> }
        else if (selected.Kind == "Rule") { @if (selected.SourceRequest.Length > 0) { <h3>Source request supplied by the assistant</h3><pre class="instruction-canonical">@selected.SourceRequest</pre> } var rule = JsonSerializer.Deserialize<RuleInput>(selected.PayloadJson)!; <dl class="ai-facts"><div><dt>Document type</dt><dd>@rule.DocumentType</dd></div><div><dt>Destination</dt><dd>@FolderName(rule.DestinationFolderId)</dd></div><div><dt>Filename pattern</dt><dd>@rule.FilenameTemplate</dd></div>@foreach (var condition in rule.Match) { <div><dt>@condition.Key</dt><dd>@condition.Value</dd></div> }<div><dt>Required facts</dt><dd>@string.Join(", ", rule.RequiredFacts)</dd></div></dl><p class="field-hint">Accepting saves a paused rule. Test and enable it in Filing rules before using it.</p> }
        else if (filingPreview != null) { <dl class="ai-facts"><div><dt>Current file</dt><dd>@filingPreview.SourcePath</dd></div><div><dt>Exact destination</dt><dd>@filingPreview.DestinationPath</dd></div><div><dt>Rule version</dt><dd>@filingPreview.RuleRevision</dd></div><div><dt>Approval expires</dt><dd>@filingPreview.ExpiresAt.ToLocalTime().ToString("MMM d, h:mm tt")</dd></div></dl><p class="field-hint">Approval permits this connection to perform only this previewed move. It cannot approve other documents. The file and rules are checked again at execution.</p> }
        @if (selected.State == "Pending") { <div class="workflow-actions"><button class="button primary" disabled="@busy" @onclick="() => Decide(true)">@(selected.Kind == "Filing" ? "Approve exact filing" : selected.Kind == "Rule" ? "Save paused rule" : "Save instruction version")</button><button class="button subtle" disabled="@busy" @onclick="() => Decide(false)">Reject proposal</button></div> }
    </section>
}
<details class="paper-panel assistant-audit"><summary>Assistant audit · latest 100 events</summary>@foreach (var item in changes.Audit) { <div><span>@item.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</span><strong>@item.Action</strong><span>@item.Outcome</span><small>@ConnectionName(item.ConnectionId)</small></div> }</details>
@code {
    [Parameter, EditorRequired] public LibraryOverview Overview { get; set; } = default!;
    [Parameter] public EventCallback Changed { get; set; }
    private string name = "", callbacks = "", currentGuidance = "";
    private bool readDocuments, proposeInstructions = true, proposeRules = true, execute, publicClient, busy, error;
    private string? message;
    private RegisteredAssistant? registered;
    private List<AssistantConnection> connections = [];
    private AssistantPage changes = new([], []);
    private AssistantProposal? selected;
    private FilingPreview? filingPreview;
    private async Task<string> Actor() => (await Authentication.GetAuthenticationStateAsync()).User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
    private string ConnectionName(Guid? id) => id == null ? "Instruction workspace" : connections.FirstOrDefault(x => x.Id == id)?.Name ?? "Assistant";
    private string FolderName(Guid id) { var folder = Overview.Folders.FirstOrDefault(x => x.Id == id); return folder == null ? "Unavailable folder" : (Overview.Roots.FirstOrDefault(x => x.Id == folder.RootId)?.Name ?? "Storage") + " / " + folder.RelativePath; }
    private static string ProposalName(AssistantProposal item) => item.Kind switch { "Guidance" => "Instruction update", "Rule" => JsonSerializer.Deserialize<RuleInput>(item.PayloadJson)!.Name, _ => "Exact document filing" };
    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load()
    {
        var actor = await Actor(); await using var scope = Scopes.CreateAsyncScope();
        connections = await scope.ServiceProvider.GetRequiredService<AssistantConnections>().ListAsync(actor);
        changes = await Library.AssistantChangesAsync(actor);
        if (selected != null) selected = changes.Proposals.FirstOrDefault(x => x.Id == selected.Id);
    }
    private async Task Refresh() => await Run(Load);
    private async Task Register() => await Run(async () =>
    {
        var permissions = new List<string> { "catalog.read" };
        if (readDocuments || execute) permissions.Add("documents.read"); if (proposeInstructions) permissions.Add("instructions.propose"); if (proposeRules) permissions.Add("rules.propose"); if (execute) permissions.Add("filing.execute");
        await using var scope = Scopes.CreateAsyncScope();
        registered = await scope.ServiceProvider.GetRequiredService<AssistantConnections>().CreateAsync(name, callbacks.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries), permissions.ToArray(), publicClient, await Actor());
        name = callbacks = ""; await Load(); message = "MCP connection created. Copy its details, then authorize it from your client.";
    });
    private async Task Revoke(Guid id) => await Run(async () => { await Library.RevokeAssistantConnectionAsync(id, await Actor()); registered = null; await Load(); message = "Connection revoked. Its pending and approved proposals are blocked too."; });
    private async Task Select(AssistantProposal proposal)
    {
        selected = proposal; filingPreview = null; currentGuidance = "";
        if (proposal.Kind == "Guidance") currentGuidance = (await Library.InstructionThreadAsync(JsonSerializer.Deserialize<GuidanceChange>(proposal.PayloadJson)!.Target)).Text;
        if (proposal.FilingPreviewId != null) { await using var scope = Scopes.CreateAsyncScope(); var factory = scope.ServiceProvider.GetRequiredService<IDbContextFactory<CatalogDb>>(); await using var db = await factory.CreateDbContextAsync(); filingPreview = await db.FilingPreviews.AsNoTracking().SingleAsync(x => x.Id == proposal.FilingPreviewId); }
    }
    private async Task Decide(bool accept) => await Run(async () => { if (selected == null) return; await Library.DecideAssistantProposalAsync(selected.Id, selected.Revision, accept, await Actor()); await Load(); await Changed.InvokeAsync(); message = accept ? selected?.Kind == "Filing" ? "Exact filing approved. The connected assistant may execute it before expiry." : "Proposed change saved." : "Proposal rejected."; });
    private async Task Run(Func<Task> work)
    {
        if (busy) return; busy = true; error = false; message = null;
        try { await work(); }
        catch (Exception ex) { Logger.LogWarning("Assistant action failed: {Kind}", ex.GetType().Name); error = true; message = ex is StorageException ? ex.Message : "The assistant action could not finish. Refresh and try again."; }
        finally { busy = false; }
    }
}

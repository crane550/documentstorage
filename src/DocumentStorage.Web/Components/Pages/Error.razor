@page "/Error"
@layout AccountLayout
@using System.Diagnostics

<PageTitle>Something went wrong</PageTitle>
<section class="account-card">
    <div class="eyebrow">Error</div>
    <h1>Something went wrong.</h1>
    <p class="account-intro">The page could not be shown. Your files were not changed by this error.</p>
    @if (ShowRequestId) { <p class="account-footnote">Request <code>@RequestId</code></p> }
    <a class="button primary full-width" href="/" data-enhance-nav="false">Back to the inbox</a>
</section>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);
    protected override void OnInitialized() => RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}

@inject LibraryService Library
@inject WorkspaceState Workspace
@inject IServiceScopeFactory Scopes
@inject ILogger<ProposalDialog> Logger
@using System.Text.Json
@using Microsoft.EntityFrameworkCore

@* An assistant's suggestion, side by side with what it would change. Nothing happens until you accept it. *@
<Modal Title="@Name(Proposal)" IconName="@KindIcon(Proposal.Kind)" OnClose="OnClose" Busy="busy" Wide="true" Class="proposal-details">
    <p class="proposal-meta"><Stamp Text="@Proposal.State" Tone="@StateTone(Proposal.State)" /><span>From @Source · @WorkspaceState.Ago(Proposal.CreatedAt)</span></p>
    @if (Proposal.SourceRequest.Length > 0) { <div class="quote"><span>What was asked</span><p>@Proposal.SourceRequest</p></div> }
    @if (Proposal.Kind == "Guidance" && guidance != null)
    {
        <p class="lede">@TargetName(guidance.Target)@(guidance.Explanation.Length > 0 ? " — " + guidance.Explanation : "")</p>
        <div class="compare"><div><h3>Now</h3><pre class="instruction-canonical">@(current.Length > 0 ? current : "(empty)")</pre></div><div><h3>Suggested</h3><pre class="instruction-canonical proposed">@guidance.Text</pre></div></div>
    }
    else if (Proposal.Kind == "Rule" && rule != null)
    {
        <dl class="ai-facts rule-facts">
            <div><dt>Document type</dt><dd>@rule.DocumentType</dd></div>
            @foreach (var condition in rule.Match) { <div><dt>When @condition.Key is</dt><dd>@condition.Value</dd></div> }
            <div><dt>Goes to</dt><dd>@Workspace.FolderLabel(rule.DestinationFolderId)</dd></div>
            <div><dt>Named</dt><dd class="mono">@rule.FilenameTemplate</dd></div>
        </dl>
        <p class="hint">Accepting adds this rule switched off. Turn it on in Rules when you are happy with it.</p>
    }
    else if (Proposal.Kind == "Details" && details != null)
    {
        <dl class="ai-facts rule-facts">
            <div><dt>Document</dt><dd>@Summary("document") <span class="mono hint">@Summary("path")</span></dd></div>
            <div><dt>Kind</dt><dd>@details.Kind</dd></div>
            <div><dt>From</dt><dd>@(details.From.Length > 0 ? details.From : "(none)")</dd></div>
            <div><dt>Date</dt><dd>@(details.Date.Length > 0 ? details.Date : "(none)")</dd></div>
            @if (details.Title.Length > 0) { <div><dt>Title</dt><dd>@details.Title</dd></div> }
            @if (details.Tags.Length > 0) { <div><dt>Tags</dt><dd>@string.Join(", ", details.Tags.Select(x => "#" + x))</dd></div> }
            @foreach (var field in details.Fields) { <div><dt>@field.Key.Replace('_', ' ')</dt><dd>@field.Value</dd></div> }
        </dl>
        <p class="hint">Accepting saves these details on the document. The file stays where it is; if its kind would put it elsewhere, it shows under Kinds › Tidy up.</p>
    }
    else if (Proposal.Kind == "Kind" && kind != null)
    {
        <dl class="ai-facts rule-facts">
            <div><dt>Kind</dt><dd>@kind.Name@(kind.KindId == null ? " (new)" : "")</dd></div>
            @if (kind.Description.Length > 0) { <div><dt>Covers</dt><dd>@kind.Description</dd></div> }
            <div><dt>Folder</dt><dd class="mono">@kind.FolderPattern</dd></div>
            <div><dt>Name</dt><dd class="mono">@kind.NamePattern</dd></div>
            @if (kind.Fields.Length > 0) { <div><dt>Fields</dt><dd>@string.Join(", ", kind.Fields)</dd></div> }
            <div><dt>Example</dt><dd class="mono">@Summary("example")</dd></div>
        </dl>
        <p class="hint">Accepting saves the kind. It doesn't change whether the kind files itself, and moves nothing: documents that now belong elsewhere show under Tidy up.</p>
    }
    else if (Proposal.Kind == "Merge" && merge != null)
    {
        <p class="lede">Merge the @merge.What <strong>@Summary("from")</strong> into <strong>@Summary("into")</strong>.</p>
        <p class="hint">@Summary("into") keeps its name; @Summary("from") becomes one of its spellings and its documents move over. Nothing moves on disk until you choose to under Tidy up.</p>
    }
    else if (Proposal.Kind == "Refile")
    {
        <ul class="proposal-moves">@foreach (var move in Moves) { <li><strong>@move.Name</strong><span class="mono tidy-from">@move.From</span><span class="mono tidy-to">→ @move.To</span></li> }</ul>
        <p class="hint">Accepting moves these through the recoverable journal. Each is checked again first; nothing is overwritten.</p>
    }
    else if (preview != null)
    {
        <div class="compare move-compare"><div><h3>Now</h3><code>@preview.SourcePath</code></div><div><h3>Would move to</h3><code>@preview.DestinationPath</code></div></div>
        <p class="hint">Approving lets this assistant make only this one move, before @preview.ExpiresAt.ToLocalTime().ToString("h:mm tt"). The file and rules are checked again when it runs.</p>
    }
    @if (error != null) { <p class="form-error" role="alert">@error</p> }
    @if (Proposal.State == "Pending")
    {
        <div class="form-actions">
            <button type="button" class="button" disabled="@busy" @onclick="() => Decide(false)">Reject</button>
            <button type="button" class="button primary" disabled="@busy" @onclick="() => Decide(true)">@(Proposal.Kind switch { "Filing" => "Approve this move", "Rule" => "Add paused rule", "Details" => "Save these details", "Kind" => "Save this kind", "Merge" => "Merge", "Refile" => $"Move {Moves.Count}", _ => "Use this version" })</button>
        </div>
    }
</Modal>
@code {
    [Parameter, EditorRequired] public AssistantProposal Proposal { get; set; } = default!;
    [Parameter] public string Source { get; set; } = "an assistant";
    [Parameter] public List<DocumentTypeProfile> Types { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnDecided { get; set; }
    private GuidanceChange? guidance;
    private RuleInput? rule;
    private FilingPreview? preview;
    private string current = "";
    private string? error;
    private bool busy;
    public static string Name(AssistantProposal item) => item.Kind switch
    {
        "Guidance" => "Guidance update",
        "Rule" => "New rule: " + (JsonSerializer.Deserialize<RuleInput>(item.PayloadJson)?.Name ?? ""),
        "Details" => "Document details",
        "Kind" => "Kind: " + (JsonSerializer.Deserialize<KindProposal>(item.PayloadJson)?.Name ?? ""),
        "Merge" => "Merge " + (JsonSerializer.Deserialize<MergeProposal>(item.PayloadJson)?.What ?? "") + "s",
        "Refile" => "Tidy up: move " + (JsonSerializer.Deserialize<RefileProposal>(item.PayloadJson)?.DocumentIds.Length ?? 0) + " documents",
        _ => "File one document"
    };
    private DetailsProposal? details;
    private KindProposal? kind;
    private MergeProposal? merge;
    private sealed record MoveRow(string Name, string From, string To);
    private List<MoveRow> Moves => Proposal.Kind != "Refile" ? [] : (JsonSerializer.Deserialize<List<JsonElement>>(Proposal.ResultJson) ?? [])
        .Select(x => new MoveRow(x.GetProperty("name").GetString() ?? "", x.GetProperty("from").GetString() ?? "", x.GetProperty("to").GetString() ?? "")).ToList();
    private string Summary(string key)
    {
        try { using var json = JsonDocument.Parse(Proposal.ResultJson); return json.RootElement.ValueKind == JsonValueKind.Object && json.RootElement.TryGetProperty(key, out var v) ? v.ToString() : ""; }
        catch (JsonException) { return ""; }
    }
    public static string KindIcon(string kind) => kind switch { "Guidance" => "note", "Rule" => "signpost", "Details" or "Kind" or "Merge" => "tag", _ => "move" };
    public static string StateTone(string state) => state switch { "Pending" => "attention", "Applied" or "Approved" or "Executed" => "ready", "Rejected" or "Expired" or "Blocked" => "muted", _ => "muted" };
    private string TargetName(InstructionTarget target) => target.Kind switch
    {
        "global" => "General reader guidance",
        "folder" => "Notes for " + (Guid.TryParse(target.Key, out var id) ? Workspace.FolderLabel(id) : "a folder"),
        _ => "How to recognize " + (Types.FirstOrDefault(x => x.Key == target.Key)?.Name ?? target.Key)
    };
    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (Proposal.Kind == "Guidance") { guidance = JsonSerializer.Deserialize<GuidanceChange>(Proposal.PayloadJson); if (guidance != null) current = (await Library.InstructionThreadAsync(guidance.Target)).Text; }
            else if (Proposal.Kind == "Rule") rule = JsonSerializer.Deserialize<RuleInput>(Proposal.PayloadJson);
            else if (Proposal.Kind == "Details") details = JsonSerializer.Deserialize<DetailsProposal>(Proposal.PayloadJson);
            else if (Proposal.Kind == "Kind") kind = JsonSerializer.Deserialize<KindProposal>(Proposal.PayloadJson);
            else if (Proposal.Kind == "Merge") merge = JsonSerializer.Deserialize<MergeProposal>(Proposal.PayloadJson);
            else if (Proposal.FilingPreviewId != null)
            {
                await using var scope = Scopes.CreateAsyncScope();
                await using var db = await scope.ServiceProvider.GetRequiredService<IDbContextFactory<CatalogDb>>().CreateDbContextAsync();
                preview = await db.FilingPreviews.AsNoTracking().SingleOrDefaultAsync(x => x.Id == Proposal.FilingPreviewId);
            }
        }
        catch (Exception ex) { Logger.LogWarning("Proposal details failed: {Kind}", ex.GetType().Name); error = ex is StorageException ? ex.Message : "The details could not load."; }
    }
    private async Task Decide(bool accept)
    {
        if (busy) return; busy = true; error = null;
        try
        {
            await Library.DecideAssistantProposalAsync(Proposal.Id, Proposal.Revision, accept, await Workspace.ActorAsync());
            await Workspace.RefreshAsync();
            await OnDecided.InvokeAsync(!accept ? "Suggestion rejected." : Proposal.Kind == "Filing" ? "Move approved. The assistant can carry it out before it expires." : Proposal.Kind == "Rule" ? "Rule added, switched off." : "Guidance updated.");
        }
        catch (Exception ex) { Logger.LogWarning("Proposal decision failed: {Kind}", ex.GetType().Name); error = ex is StorageException ? ex.Message : "That could not be saved. Refresh and try again."; }
        finally { busy = false; }
    }
}

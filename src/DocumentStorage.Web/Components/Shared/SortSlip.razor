@inject LibraryService Library
@inject WorkspaceState Workspace
@inject ILogger<SortSlip> Logger
@inject IJSRuntime JS
@implements IAsyncDisposable

@*
    The filing slip: what the document is, who it's from, its date, title and tags. You correct
    the details, never a path; the folder and name below follow them live from the kind's
    patterns. Enter (or Approve & file) files it and moves on to the next one.
*@
<form class="slip sort-slip" aria-label="Filing slip" aria-busy="@(busy ? "true" : "false")" @onsubmit="Approve" @onsubmit:preventDefault>
    <header class="slip-head">
        <span class="slip-kicker">Filing slip</span>
        <h2 title="@Card.Document.Name">@Card.Document.Name</h2>
        <div class="slip-tools">
            <a class="icon-button small" href="@($"/documents/{Card.Document.Id}/download")" download title="Download original" aria-label="Download original"><Icon Name="download" Size="16" /></a>
            <Menu Label="More actions" ButtonClass="icon-button small" IconSize="16">
                @if (Workspace.ReaderEnabled) { <button role="menuitem" type="button" disabled="@(busy || !CanRead || Reading)" @onclick="ReadWithAi"><Icon Name="spark" Size="15" />@(Card.JobId == null ? "Read with AI" : "Read again with AI")</button> }
                <button role="menuitem" type="button" @onclick="() => RequestMove.InvokeAsync(Card.Document.Id)"><Icon Name="move" Size="15" />Move by hand…</button>
                <button role="menuitem" type="button" disabled="@(busy || !Card.Document.Online)" @onclick="() => RequestRescan.InvokeAsync(Card.Document.Id)"><Icon Name="refresh" Size="15" />Rescan text</button>
                <button role="menuitem" type="button" disabled="@(busy || !Card.Document.Online)" @onclick="() => RequestDelete.InvokeAsync(Card.Document.Id)"><Icon Name="trash" Size="15" />Not a document: delete…</button>
            </Menu>
        </div>
    </header>

    @* One line on how the slip was filled in, with anything new it found. *@
    <div class="sort-reader @(Reading ? "working" : "")" role="status">
        @if (Reading) { <span class="spin"><Icon Name="refresh" Size="14" /></span><span>@Card.ReaderState…</span> }
        else if (Card.Sources.GetValueOrDefault("kind") == "memory") { <Icon Name="history" Size="15" /><span>@(MemoryNote ?? "Filled in from memory")@(Card.Sure ? ", no reading needed. Check it and press Enter." : ". Check the pencilled-in parts.")</span> }
        else if (Card.Sure) { <Icon Name="check-circle" Size="15" /><span>Read and sure. Check it and press Enter.</span> }
        else if (Card.ReaderState == "Read") { <Icon Name="spark" Size="15" /><span>Read by the reader@(Card.Confidence.Length > 0 ? $" ({Card.Confidence} confidence)" : ""). Check the pencilled-in parts.</span> }
        else if (Card.ReaderState.StartsWith("Reading failed") || Card.ReaderState is "Needs reading again" or "Reading cancelled")
        { <Icon Name="alert" Size="15" /><span>@Card.ReaderState</span>@if (CanRead) { <button type="button" class="text-button" disabled="@busy" @onclick="ReadWithAi">Try again</button> } }
        else if (Workspace.ReaderEnabled && CanRead && Card.JobId == null) { <Icon Name="spark" Size="15" /><span>Not read yet.</span><button type="button" class="text-button" disabled="@busy" @onclick="ReadWithAi">Read with AI</button> }
        else if (!CanRead) { <Icon Name="info" Size="15" /><span>@(Card.Document.Readiness != "Ready" ? "Still arriving…" : "No text to read (" + Card.Document.TextStatus + "). Fill it in by hand.")</span> }
        else { <Icon Name="info" Size="15" /><span>Filled in from the file name and text.</span> }
        @if (Warnings.Any() && !edited) { <ul class="sort-notes">@foreach (var note in Warnings) { <li>@note</li> }</ul> }
    </div>

    <div class="slip-body">
        @* What it is: the details you check. The folder and name on the right follow them. *@
        <section class="slip-details sort-fields" aria-label="What it is">
            <div class="slip-cell half">
                <label class="slip-label" for="sort-kind">Kind <SourceMark Source="@Source("kind")" />@if (CurrentKind != null) { <button type="button" class="slip-label-action" @onclick="EditKind">Edit kind…</button> }</label>
                <div class="sort-field-row">
                    <input id="sort-kind" class="slip-field @Guess("kind")" list="sort-kinds" @bind="kind" @bind:event="oninput" @bind:after="Typed" placeholder="What is it?" maxlength="60" autocomplete="off" />
                    @if (plan?.NewKind == true && kind.Trim().Length > 0) { <span class="new-mark" title="Approving makes this a new kind">new</span> }
                </div>
                <datalist id="sort-kinds">@foreach (var k in Vocabulary.Kinds) { <option value="@k.Name">@k.Description</option> }</datalist>
            </div>
            <div class="slip-cell half">
                <label class="slip-label" for="sort-from">From <SourceMark Source="@Source("from")" /></label>
                <div class="sort-field-row">
                    <input id="sort-from" class="slip-field @Guess("from")" list="sort-senders" @bind="from" @bind:event="oninput" @bind:after="Typed" placeholder="Who sent it?" maxlength="80" autocomplete="off" />
                    @if (plan?.NewSender == true) { <span class="new-mark" title="Approving adds this sender">new</span> }
                </div>
                <datalist id="sort-senders">@foreach (var s in Vocabulary.Senders) { <option value="@s.Name" /> }</datalist>
            </div>
            @if (kind.Trim().Length == 0)
            {
                <div class="slip-cell full type-picks" aria-label="Choose a kind">@foreach (var k in Vocabulary.Kinds.OrderByDescending(x => Vocabulary.KindUse.GetValueOrDefault(x.Id)).Take(10)) { <button type="button" class="token" @onclick="() => PickKind(k.Name)">@k.Name</button> }</div>
            }
            <div class="slip-cell full">
                <label class="slip-label" for="sort-title">Title <SourceMark Source="@Source("title")" /></label>
                <input id="sort-title" class="slip-field" @bind="title" @bind:event="oninput" @bind:after="Typed" placeholder="Short description" maxlength="80" autocomplete="off" />
            </div>
            <div class="slip-cell date">
                <label class="slip-label" for="sort-date">Date <SourceMark Source="@Source("date")" /></label>
                <input id="sort-date" type="date" class="slip-field @Guess("date")" @bind="date" @bind:after="Changed" />
            </div>
            <div class="slip-cell rest">
                <span class="slip-label">Tags <SourceMark Source="@Source("tags")" /></span>
                <div class="tag-editor">
                    @foreach (var tag in tags)
                    {
                        <span class="tag-chip @(Vocabulary.Tags.Any(x => x.Name == tag) ? "" : "new")" @key="tag">#@tag<button type="button" aria-label="@($"Remove tag {tag}")" @onclick="() => RemoveTag(tag)">×</button></span>
                    }
                    <input class="tag-input" form="@tagFormId" list="sort-tags" @bind="newTag" placeholder="@(tags.Count == 0 ? "Add a tag" : "+ tag")" maxlength="40" autocomplete="off" aria-label="Add a tag" />
                    <datalist id="sort-tags">@foreach (var t in Vocabulary.Tags.Where(x => !tags.Contains(x.Name))) { <option value="@t.Name" /> }</datalist>
                </div>
            </div>
            <div class="slip-cell full sort-kind-fields" aria-label="Fields">
                @foreach (var name in FieldRows)
                {
                    var kept = CurrentKind is { } k && LibraryService.KindFields(k).Contains(name);
                    <div class="field-row" @key="name">
                        <label class="slip-label" for="@($"sort-field-{name}")">@LibraryService.FieldLabel(name) <SourceMark Source="@(Card.Quotes.ContainsKey(name) && !edited ? "reader" : "")" Title="@Card.Quotes.GetValueOrDefault(name)" /></label>
                        <div class="field-line">
                            @if (LibraryService.IsDateField(name) && (fields.GetValueOrDefault(name, "").Length == 0 || DateOnly.TryParseExact(fields.GetValueOrDefault(name, ""), "yyyy-MM-dd", out _)))
                            { <input id="@($"sort-field-{name}")" type="date" class="slip-field" value="@fields.GetValueOrDefault(name)" @onchange="e => SetField(name, e.Value?.ToString())" /> }
                            else
                            { <input id="@($"sort-field-{name}")" class="slip-field" value="@fields.GetValueOrDefault(name)" @oninput="e => TypeField(name, e.Value?.ToString())" maxlength="200" autocomplete="off" /> }
                            @if (CurrentKind is { } current && !kept)
                            {
                                <button type="button" class="field-keep" disabled="@busy" title="@($"Ask for this on every {current.Name}")" @onclick="() => Keep(name)"><Icon Name="plus" Size="12" />Keep for @current.Name</button>
                            }
                            <button type="button" class="field-toggle @(InDraft(name, false) ? "on" : "")" aria-pressed="@(InDraft(name, false) ? "true" : "false")" disabled="@busy" title="Use in the file name" @onclick="() => Toggle(name, false)">Name</button>
                            <button type="button" class="field-toggle @(InDraft(name, true) ? "on" : "")" aria-pressed="@(InDraft(name, true) ? "true" : "false")" disabled="@busy" title="Use as a folder" @onclick="() => Toggle(name, true)">Folder</button>
                            @if (!kept) { <button type="button" class="field-remove" aria-label="@($"Remove {LibraryService.FieldLabel(name)}")" title="Remove" @onclick="() => RemoveField(name)">×</button> }
                        </div>
                    </div>
                }
                <div class="field-add-row">
                    @* A new @key after each add gives a fresh, empty box (Blazor won't clear text it thinks is already empty). *@
                    <input class="field-add" @key="addFieldVersion" form="@fieldFormId" @bind="newField" @bind:event="oninput" placeholder="+ Add a field, like Statement end date" maxlength="64" autocomplete="off" aria-label="Add a field" />
                    @if (newField.Trim().Length > 0) { <button type="submit" form="@fieldFormId" class="button small">Add</button> }
                </div>
                @if (CurrentKind == null && kind.Trim().Length > 0 && FieldRows.Any()) { <p class="hint">These fields travel with this document; approving makes the kind with them.</p> }
            </div>
        </section>

        @* Where it goes: the folder is built from the details or chosen; the name is built, the original, or typed. *@
        <section class="slip-where destination sort-destination @(plan?.Problem == null ? "ready" : "pending")" aria-label="Where it goes" aria-live="polite">
            <div class="where-part">
                <div class="where-head">
                    <span class="slip-label">Folder</span>
                    <div class="seg" role="group" aria-label="How the folder is chosen">
                        <button type="button" aria-pressed="@(FolderMode == "built" ? "true" : "false")" @onclick='() => SetFolderMode("built")'>Built from details</button>
                        <button type="button" aria-pressed="@(FolderMode == "pick" ? "true" : "false")" @onclick='() => SetFolderMode("pick")'>Choose a folder</button>
                    </div>
                </div>
                @if (plan == null) { <p class="hint">Working out where it goes…</p> }
                else if (plan.Problem != null) { <p class="destination-problem"><Icon Name="alert" Size="14" />@plan.Problem</p> }
                else
                {
                    <p class="sort-path" data-sort-path title="@($"{Card.Document.RootName}/{plan.FolderPath}")">
                        <Icon Name="folder" Size="15" />
                        <span class="path-root">@Card.Document.RootName</span>
                        @foreach (var part in ExistingParts) { <span class="path-sep">/</span><span class="path-part">@part</span> }
                        @foreach (var part in plan.NewFolders) { <span class="path-sep">/</span><span class="path-part path-new" title="A new folder">@part</span> }
                    </p>
                    @if (plan.NewFolders.Length > 0) { <p class="hint where-note">Makes @(plan.NewFolders.Length == 1 ? "a new folder" : $"{plan.NewFolders.Length} new folders") (dashed).</p> }
                }
                @if (FolderMode == "pick")
                {
                    <label class="sr-only" for="sort-folder">Folder inside @Card.Document.RootName</label>
                    <input id="sort-folder" class="slip-field mono" @bind="folderOverride" @bind:event="oninput" @bind:after="Typed" placeholder="Type or pick a folder, like Banking/Cedar Bank" autocomplete="off" />
                    <ul class="folder-matches" aria-label="Folders">
                        @foreach (var folder in FolderMatches)
                        {
                            <li @key="folder.Id"><button type="button" class="@(string.Equals(folder.RelativePath, folderOverride.Trim().Trim('/'), StringComparison.OrdinalIgnoreCase) ? "chosen" : "")" @onclick="() => PickFolder(folder.RelativePath)"><Icon Name="folder" Size="13" /><span>@folder.RelativePath</span></button></li>
                        }
                    </ul>
                    <p class="hint">Pick one, or type a path; folders that don't exist yet are made when you approve. Used for this document only.</p>
                }
                else
                {
                    <div class="sort-arrange">
                        <button type="button" class="button small" aria-expanded="@(showArranger ? "true" : "false")" @onclick="() => showArranger = !showArranger"><Icon Name="move" Size="13" />@(showArranger ? "Done arranging" : "Arrange folders & name")</button>
                        @if (touched && kind.Trim().Length > 0)
                        {
                            @if (CurrentKind != null) { <label class="check"><input type="checkbox" @bind="keepArrangement" /> Use for every @CurrentKind.Name</label> }
                            else { <span class="hint">A new kind starts with this arrangement.</span> }
                        }
                    </div>
                    @if (showArranger)
                    {
                        <PatternComposer FolderPattern="@draftFolder" NamePattern="@draftName" Fields="FieldRows" Values="SampleValues" Extension="@System.IO.Path.GetExtension(Card.Document.Name)"
                                         NameKept="keepName" Changed="Arranged" />
                    }
                }
            </div>
            <div class="where-part">
                <div class="where-head">
                    <span class="slip-label">Name</span>
                    <div class="seg" role="group" aria-label="How the name is chosen">
                        <button type="button" aria-pressed="@(NameMode == "built" ? "true" : "false")" @onclick='() => SetNameMode("built")'>Built</button>
                        <button type="button" aria-pressed="@(NameMode == "original" ? "true" : "false")" @onclick='() => SetNameMode("original")'>Original</button>
                        <button type="button" aria-pressed="@(NameMode == "custom" ? "true" : "false")" @onclick='() => SetNameMode("custom")'>Type it</button>
                    </div>
                </div>
                @if (plan != null && plan.Problem == null) { <p class="sort-name mono" data-sort-name><Icon Name="file" Size="14" />@plan.FileName</p> }
                @if (NameMode == "custom")
                {
                    <label class="sr-only" for="sort-name">File name</label>
                    <input id="sort-name" class="slip-field mono" @bind="nameOverride" @bind:event="oninput" @bind:after="Typed" placeholder="File name" autocomplete="off" />
                    <p class="hint">Used for this document only. The extension is added for you.</p>
                }
            </div>
        </section>
    </div>

    @* Always in reach: the bar stays at the bottom of the screen while the slip is in view. *@
    <footer class="slip-actions">
        <label class="check remember" title="The reader learns from documents you approve this way"><input type="checkbox" @bind="remember" /> Remember as an example</label>
        <span class="grow"></span>
        <button type="button" class="text-button" data-sort-next-button @onclick="() => Skip.InvokeAsync()">Skip</button>
        <button type="submit" class="button primary" data-sort-approve disabled="@(busy || plan?.Problem != null || plan == null || !Card.Document.Online)"><Icon Name="check" Size="16" />Approve &amp; file<kbd>Enter</kbd></button>
    </footer>
</form>
<form id="@tagFormId" class="sr-only" @onsubmit="AddTag" @onsubmit:preventDefault aria-hidden="true"><button type="submit" tabindex="-1">Add tag</button></form>
<form id="@fieldFormId" class="sr-only" @onsubmit="AddField" @onsubmit:preventDefault aria-hidden="true"><button type="submit" tabindex="-1">Add field</button></form>
@if (editingKind != null)
{
    <Modal Title="@($"Edit {editingKind.Name}")" IconName="edit" OnClose="() => editingKind = null" Wide="true">
        <KindForm Kind="editingKind" Busy="busy" Save="SaveKind" Cancel="() => editingKind = null" />
    </Modal>
}

@code {
    [Parameter, EditorRequired] public SortCard Card { get; set; } = default!;
    [Parameter, EditorRequired] public SortVocabulary Vocabulary { get; set; } = default!;
    [Parameter] public EventCallback<string> Filed { get; set; }
    [Parameter] public EventCallback ReadingChanged { get; set; }
    [Parameter] public EventCallback Skip { get; set; }
    // A kind changed from the slip (a kept field, a pattern): the page reloads what Stash knows.
    [Parameter] public EventCallback VocabularyChanged { get; set; }
    [Parameter] public EventCallback<Guid> RequestMove { get; set; }
    [Parameter] public EventCallback<Guid> RequestDelete { get; set; }
    [Parameter] public EventCallback<Guid> RequestRescan { get; set; }

    private readonly string fieldFormId = "field-form-" + Guid.NewGuid().ToString("N")[..8];
    private string newField = "";
    private DocumentKind? editingKind;
    private readonly string tagFormId = "tag-form-" + Guid.NewGuid().ToString("N")[..8];
    private string kind = "", from = "", title = "", newTag = "", folderOverride = "", nameOverride = "";
    private DateOnly? date;
    private List<string> tags = [];
    private Dictionary<string, string> fields = [];
    private bool keepName, remember = true, busy, edited;
    // The arrangement being worked on for this document: the kind's patterns until touched.
    private string draftFolder = LibraryService.DefaultKindFolder, draftName = LibraryService.DefaultKindName, draftKind = "";
    private bool touched, keepArrangement = true, showArranger;
    private SortPlan? plan;
    private string? loadedKey;
    private int planVersion;

    private bool pickingFolder, customName;
    private CancellationTokenSource? typingPause;
    private string FolderMode => pickingFolder || folderOverride.Trim().Length > 0 ? "pick" : "built";
    private string NameMode => customName || nameOverride.Trim().Length > 0 ? "custom" : keepName ? "original" : "built";
    // Folders to pick from: those matching what's typed; when nothing matches yet (a path still to be made),
    // the deepest folder that exists along it and what's inside, so you see what is already there.
    private IEnumerable<CatalogEntry> FolderMatches
    {
        get
        {
            var typed = folderOverride.Trim().Trim('/');
            var folders = Workspace.Overview.Folders.Where(x => x.RootId == Card.Document.RootId && x.RelativePath.Length > 0 && !Workspace.InInbox(x)).ToList();
            var matching = folders.Where(x => typed.Length == 0 || x.RelativePath.Contains(typed, StringComparison.OrdinalIgnoreCase)).ToList();
            if (matching.Count == 0 && typed.Length > 0)
            {
                var parts = typed.Split('/', StringSplitOptions.RemoveEmptyEntries);
                for (var depth = parts.Length - 1; depth > 0 && matching.Count == 0; depth--)
                {
                    var prefix = string.Join("/", parts[..depth]);
                    matching = folders.Where(x => string.Equals(x.RelativePath, prefix, StringComparison.OrdinalIgnoreCase)
                        || x.RelativePath.StartsWith(prefix + "/", StringComparison.OrdinalIgnoreCase)).ToList();
                }
            }
            return matching.OrderBy(x => string.Equals(x.RelativePath, typed, StringComparison.OrdinalIgnoreCase) ? 0 : 1)
                .ThenBy(x => x.RelativePath, StringComparer.OrdinalIgnoreCase).Take(10);
        }
    }
    private string? MemoryNote => Card.Notes.FirstOrDefault(x => x.StartsWith("Filled in from", StringComparison.Ordinal));
    private IEnumerable<string> Warnings => Card.Notes.Where(x => !x.StartsWith("Filled in from", StringComparison.Ordinal));
    private bool Reading => Card.ReaderState is "Waiting to be read" or "Reading" or "Will try again";
    private bool CanRead => Card.Document.Readiness == "Ready" && Card.Document.TextStatus == "Indexed" && Card.Document.Online;
    private IEnumerable<string> ExistingParts => plan == null || plan.FolderPath.Length == 0 ? [] : plan.FolderPath.Split('/')[..^plan.NewFolders.Length];
    private string Source(string key) => edited ? "" : Card.Sources.GetValueOrDefault(key, "");
    private string Guess(string key) => Source(key) == "guess" ? "guess" : "";

    protected override async Task OnParametersSetAsync()
    {
        // A new document, or a reading arriving for one not yet touched, refills the slip.
        var key = Card.Document.Id + "|" + Card.JobId + "|" + Card.ReaderState + "|" + Card.Document.ContentHash;
        if (key == loadedKey) return;
        var sameDocument = loadedKey?.StartsWith(Card.Document.Id.ToString()) == true;
        loadedKey = key;
        if (sameDocument && edited) return;
        kind = Card.Choice.Kind; from = Card.Choice.From; date = Card.Choice.Date; title = Card.Choice.Title;
        tags = Card.Choice.Tags.ToList(); fields = new(Card.Choice.Fields); keepName = Card.Choice.KeepName;
        folderOverride = ""; nameOverride = ""; pickingFolder = false; customName = false; edited = false; plan = Card.Plan;
        draftKind = "\u0000"; SyncDraft();
        await Task.CompletedTask;
    }

    private SortChoice Choice() => new(kind.Trim(), from.Trim(), date, title.Trim(), tags.ToArray(),
        fields.Where(x => x.Value.Trim().Length > 0).ToDictionary(x => x.Key, x => x.Value.Trim()), keepName, nameOverride.Trim(), folderOverride.Trim(), remember,
        touched ? draftFolder : null, touched ? draftName : null, touched && keepArrangement);

    // A different kind brings its own arrangement; an untouched draft follows the kind.
    private void SyncDraft()
    {
        if (string.Equals(draftKind, kind.Trim(), StringComparison.OrdinalIgnoreCase)) return;
        draftKind = kind.Trim(); touched = false; keepArrangement = true;
        draftFolder = CurrentKind?.FolderPattern ?? LibraryService.DefaultKindFolder;
        draftName = CurrentKind?.NamePattern ?? LibraryService.DefaultKindName;
    }
    private SortValues SampleValues => new(kind.Trim(), from.Trim(), date, title.Trim(), fields);
    private bool InDraft(string field, bool folder) => SortPatterns.TokensIn(folder ? draftFolder : draftName).Contains(field);
    private async Task Arranged((string Folder, string Name) value)
    {
        // Rearranging the name means using it, not the original name.
        if (value.Name != draftName) { keepName = false; customName = false; nameOverride = ""; }
        if (value.Folder != draftFolder) { pickingFolder = false; folderOverride = ""; }
        draftFolder = value.Folder; draftName = value.Name; touched = true;
        await Changed();
    }

    private async Task Changed()
    {
        edited = true; SyncDraft();
        var version = ++planVersion;
        try
        {
            var next = await Library.PlanSortAsync(Card.Document.Id, Choice());
            if (version == planVersion) plan = next;
        }
        catch (StorageException ex) { if (version == planVersion) plan = new("", [], Card.Document.Name, false, false, [], ex.Message); }
    }
    private Task PickKind(string name) { kind = name; return Changed(); }
    // Typing replans after a short pause, so the folder and name follow along without a request per key.
    private async Task Typed()
    {
        edited = true;
        typingPause?.Cancel();
        var pause = typingPause = new CancellationTokenSource();
        try { await Task.Delay(250, pause.Token); }
        catch (TaskCanceledException) { return; }
        await Changed();
    }
    private Task TypeField(string name, string? value) { fields[name] = value ?? ""; return Typed(); }
    private Task SetFolderMode(string mode)
    {
        pickingFolder = mode == "pick";
        // Choosing starts from where it would go now, so a small change is a small edit.
        if (pickingFolder && folderOverride.Trim().Length == 0) folderOverride = plan?.Problem == null ? plan?.FolderPath ?? "" : "";
        if (!pickingFolder) folderOverride = "";
        return Changed();
    }
    private Task PickFolder(string path) { folderOverride = path; pickingFolder = true; return Changed(); }
    private Task SetNameMode(string mode)
    {
        customName = mode == "custom"; keepName = mode == "original";
        if (customName && nameOverride.Trim().Length == 0) nameOverride = plan?.Problem == null && plan != null ? System.IO.Path.GetFileNameWithoutExtension(plan.FileName) : "";
        if (!customName) nameOverride = "";
        return Changed();
    }
    private Task SetField(string name, string? value) { fields[name] = value ?? ""; return Changed(); }
    private DocumentKind? CurrentKind => Vocabulary.Kinds.FirstOrDefault(x => string.Equals(x.Name, kind.Trim(), StringComparison.OrdinalIgnoreCase));
    // The kind's own fields first, then any added on this document.
    private IEnumerable<string> FieldRows => (CurrentKind is { } k ? LibraryService.KindFields(k) : []).Concat(fields.Keys).Distinct();
    private int addFieldVersion;
    private IJSObjectReference? keys;
    private string? focusField;
    private async Task AddField()
    {
        var label = newField.Trim(); newField = ""; addFieldVersion++;
        if (label.Length == 0) return;
        string key;
        try { key = LibraryService.FieldKey(label); }
        catch (StorageException ex) { Workspace.Notify(ex.Message, true); return; }
        // Already on the slip (perhaps under a slightly different spelling): go to it rather than doing nothing.
        var existing = FieldRows.Contains(key);
        if (!fields.ContainsKey(key)) fields[key] = "";
        focusField = key;
        if (!existing) await Changed();
    }
    public async ValueTask DisposeAsync()
    {
        typingPause?.Cancel();
        if (keys == null) return;
        try { await keys.DisposeAsync(); } catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException) { }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusField is not string key) return;
        focusField = null;
        // The cursor goes straight to the new field's value.
        try { keys ??= await JS.InvokeAsync<IJSObjectReference>("import", "./sort-keys.js"); await keys.InvokeVoidAsync("focusById", "sort-field-" + key); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException) { }
    }
    private Task RemoveField(string name) { fields.Remove(name); return Changed(); }
    private async Task Keep(string name) => await KindChange(async actor =>
    {
        await Library.AddKindFieldAsync(kind, name, actor); // The button turning into Name / Folder says it worked.
    });
    // Name and Folder on a field change this document's arrangement (kept for the kind if "Use for every" stays ticked).
    private async Task Toggle(string name, bool folder)
    {
        var token = "{" + name + (folder && LibraryService.IsDateField(name) ? ":yyyy" : "") + "}";
        if (folder) { pickingFolder = false; folderOverride = ""; } else { customName = false; nameOverride = ""; }
        if (folder)
        {
            var levels = PatternParts.ParseFolder(draftFolder);
            if (InDraft(name, true)) levels = levels.Select(l => l.Where(p => p.Token != name).ToList()).Where(l => l.Count > 0).ToList();
            else levels.Add(PatternParts.Parse(token));
            draftFolder = PatternParts.JoinFolder(levels);
        }
        else
        {
            var parts = PatternParts.Parse(draftName);
            if (InDraft(name, false)) parts.RemoveAll(p => p.Token == name); else { parts.AddRange(PatternParts.Parse(token)); keepName = false; }
            draftName = parts.Count == 0 ? "{title}" : PatternParts.Join(parts);
        }
        touched = true;
        await Changed();
    }
    private void EditKind()
    {
        if (CurrentKind is not { } k) return;
        editingKind = new() { Id = k.Id, Name = k.Name, Description = k.Description, FolderPattern = k.FolderPattern, NamePattern = k.NamePattern, FieldsJson = k.FieldsJson, AutoFile = k.AutoFile, IsCatchAll = k.IsCatchAll, Revision = k.Revision };
    }
    private async Task SaveKind(DocumentKind input) => await KindChange(async actor =>
    {
        var saved = await Library.SaveKindAsync(input, actor); editingKind = null; kind = saved.Name;
        draftKind = "\u0000"; touched = false; // Follow the kind as just saved.
        var moving = (await Library.RefilePlanAsync(kindId: saved.Id)).Count(x => x.Problem == null);
        Workspace.Notify($"Saved {saved.Name}.{(moving > 0 ? $" {moving} filed documents could move: see Tidy up." : "")}");
    });
    private async Task KindChange(Func<string, Task> change)
    {
        if (busy) return; busy = true;
        try { await change(await Workspace.ActorAsync()); await VocabularyChanged.InvokeAsync(); edited = true; await Replan(); }
        catch (StorageException ex) { Workspace.Notify(ex.Message, true); }
        finally { busy = false; }
    }
    private async Task Replan()
    {
        var version = ++planVersion;
        try { var next = await Library.PlanSortAsync(Card.Document.Id, Choice()); if (version == planVersion) plan = next; }
        catch (StorageException ex) { if (version == planVersion) plan = new("", [], Card.Document.Name, false, false, [], ex.Message); }
    }
    private async Task AddTag()
    {
        var raw = newTag.Trim(); newTag = "";
        if (raw.Length == 0) return;
        string name;
        try { name = Vocabulary.Tags.FirstOrDefault(x => string.Equals(x.Name, raw, StringComparison.OrdinalIgnoreCase))?.Name ?? LibraryService.TagName(raw); }
        catch (StorageException ex) { Workspace.Notify(ex.Message, true); return; }
        if (!tags.Contains(name)) tags.Add(name);
        await Changed();
    }
    private Task RemoveTag(string tag) { tags.Remove(tag); return Changed(); }

    private async Task Approve()
    {
        if (busy) return;
        if (newTag.Trim().Length > 0) await AddTag();
        busy = true;
        try
        {
            var choice = Choice();
            var current = await Library.PlanSortAsync(Card.Document.Id, choice);
            plan = current;
            if (current.Problem != null) { Workspace.Notify(current.Problem, true); return; }
            await Library.FileSortedAsync(Card.Document.Id, choice, Card.Document.ContentHash, await Workspace.ActorAsync());
            var moving = choice.KeepPatterns && CurrentKind is { } kept ? (await Library.RefilePlanAsync(kindId: kept.Id)).Count(x => x.Problem == null) : 0;
            if (choice.KeepPatterns) await VocabularyChanged.InvokeAsync();
            await Filed.InvokeAsync($"Filed as {current.DestinationPath}." + (moving > 0 ? $" {moving} other {kind}s now belong elsewhere: see Kinds › Tidy up." : ""));
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Filing failed");
            Workspace.Notify(ex is StorageException ? ex.Message : "Filing could not finish. Check storage and History, then try again.", true);
        }
        finally { busy = false; }
    }

    private async Task ReadWithAi()
    {
        if (busy) return; busy = true;
        try { await Library.QueueSortingAsync(Card.Document.Id, await Workspace.ActorAsync()); edited = false; await ReadingChanged.InvokeAsync(); }
        catch (StorageException ex) { Workspace.Notify(ex.Message, true); }
        finally { busy = false; }
    }
}

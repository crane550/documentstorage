@page "/account"
@layout AccountLayout
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@inject IConfiguration Configuration

<PageTitle>Your account · @DisplayName</PageTitle>
<section class="account-card">
    <a class="account-brand" href="/" data-enhance-nav="false"><span class="brand-mark"><Icon Name="box" Size="30" /></span><span>@DisplayName</span></a>
    <div class="eyebrow">YOUR ACCOUNT</div><h1>A fresh password.</h1>
    <p class="account-intro">Signed in as <strong>@Username</strong>.</p>
    @if (Failed == true) { <p class="account-message error" role="alert">The password was not changed. Check your current password, match the new passwords, and use at least 12 characters.</p> }
    @if (Changed == true) { <p class="account-message success" role="status">Password changed. Other sign-in sessions will need to log in again.</p> }
    <form method="post" action="/account/change-password" data-enhance="false">
        <AntiforgeryToken />
        <input type="hidden" name="username" autocomplete="username" value="@Username" />
        <label for="current-password">Current password</label><input id="current-password" name="currentPassword" type="password" autocomplete="current-password" maxlength="1024" required />
        <label for="new-password">New password</label><input id="new-password" name="newPassword" type="password" autocomplete="new-password" minlength="12" maxlength="1024" required />
        <label for="confirm-password">Confirm new password</label><input id="confirm-password" name="confirmPassword" type="password" autocomplete="new-password" minlength="12" maxlength="1024" required />
        <button class="button primary full-width" type="submit">Change password</button>
    </form>
    <div class="account-footer"><a href="/" data-enhance-nav="false">Back to documents</a><form method="post" action="/account/logout" data-enhance="false"><AntiforgeryToken /><button type="submit" class="text-button">Sign out</button></form></div>
</section>
@code {
    [SupplyParameterFromQuery] public bool? Failed { get; set; }
    [SupplyParameterFromQuery] public bool? Changed { get; set; }
    [CascadingParameter] private Task<AuthenticationState> State { get; set; } = default!;
    private string DisplayName => Configuration["Application:DisplayName"] ?? "Document Manager";
    private string Username = "";
    protected override async Task OnInitializedAsync() => Username = (await State).User.Identity?.Name ?? "";
}

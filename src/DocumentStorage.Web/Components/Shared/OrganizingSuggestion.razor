@inject LibraryService Library
@inject WorkspaceState Workspace
@inject ILogger<OrganizingSuggestion> Logger
@using System.Text.Json

<section class="organizing-proposal" aria-label="AI filing proposal" aria-busy="@busy">
    <div class="reader-head"><Icon Name="spark" Size="16" /><strong>Suggested filing</strong></div>
    <p>@Job.Summary</p><p class="organizing-reason">@suggestion.Reason</p>
    @if (Job.NeedsReview) { <p class="reader-caution">The reader flagged uncertainty or shortened context. Check the original and the destination before approving.</p> }
    <form @onsubmit="Approve" @onsubmit:preventDefault @oninput="Edited" @onchange="Edited">
        <label for="organize-filename">Suggested filename</label><input id="organize-filename" maxlength="180" required @bind="filename" @bind:event="oninput" disabled="@busy" />
        <label for="organize-folder">Destination folder</label><select id="organize-folder" @bind="folderId" disabled="@busy"><option value="@Guid.Empty">Choose a folder</option>@foreach (var folder in Destinations) { <option value="@folder.Id">@Workspace.FolderLabel(folder)</option> }</select>
        <label class="check"><input type="checkbox" @bind="create" disabled="@busy" />Create a new subfolder here</label>
        @if (create) { <label for="organize-new-folder">New subfolder name</label><input id="organize-new-folder" maxlength="180" required @bind="newFolder" @bind:event="oninput" disabled="@busy" /> }
        <div class="organizing-path"><small>@(create ? "Create folder and file as" : "File as")</small><strong>@filename.Trim()</strong><span>@DestinationLabel</span></div>
        <details class="organizing-facts"><summary>Document category and suggested facts</summary><label for="organize-type">Document category</label><input id="organize-type" maxlength="64" required @bind="category" disabled="@busy" /><dl class="ai-facts">@foreach (var fact in Facts) { <div><dt>@fact.Key</dt><dd>@fact.Value@if (Evidence.GetValueOrDefault(fact.Key) is { Length: > 0 } quote) { <blockquote>@quote</blockquote> }</dd></div> }</dl><p class="hint">A new category does not need a rule or a configured type. Approving the move does not mark these suggested facts as separately verified.</p></details>
        <label for="organize-note">Filing preference or correction (optional)</label><textarea id="organize-note" rows="2" maxlength="1000" @bind="note" disabled="@busy" placeholder="For example: Church safety documents belong together, regardless of campus."></textarea>
        <label class="check"><input type="checkbox" @bind="remember" disabled="@busy" />Remember this approved filing as an example</label>
        @if (pending != null)
        { <div class="organizing-path"><small>The server resolved the exact destination to</small><strong>@pending.Filename</strong><span>@pending.DestinationPath</span><p>Review this location, then confirm below.</p></div><button type="button" class="button primary" disabled="@busy" @onclick="ApplyPending">Confirm this exact filing</button> }
        else { <button type="submit" class="button primary" disabled="@(busy || folderId == Guid.Empty || filename.Trim().Length == 0)">@(busy ? "Checking and filing…" : "Approve & file")</button> }
        <button type="button" class="text-button" disabled="@busy" @onclick="Reject">Decline suggestion</button>
    </form>
    @if (error != null) { <p class="form-error" role="alert">@error</p> }
</section>
@code {
    [Parameter,EditorRequired] public IdentificationJob Job { get; set; } = default!;
    [Parameter,EditorRequired] public CatalogEntry Entry { get; set; } = default!;
    [Parameter] public EventCallback<string> Filed { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    private Guid loaded,folderId;
    private OrganizationSuggestion suggestion=new(Guid.Empty,"","","");
    private string filename="",newFolder="",category="",note="";
    private bool create,remember=true,busy;
    private string? error;
    private OrganizationFiling? pending;
    private Dictionary<string,string> Facts => JsonSerializer.Deserialize<Dictionary<string,string>>(Job.FactsJson)??[];
    private Dictionary<string,string> Evidence => JsonSerializer.Deserialize<Dictionary<string,string>>(Job.EvidenceJson)??[];
    private bool Eligible(CatalogEntry folder)
    {
        var current=folder;
        while(current!=null) { if(current.IsIntake)return false;current=Workspace.Overview.Folders.FirstOrDefault(x=>x.Id==current.ParentId); }
        return folder.RootId==Entry.RootId && Workspace.IsWritable(folder.RootId);
    }
    private IEnumerable<CatalogEntry> Destinations => Workspace.Overview.Folders.Where(Eligible).OrderBy(x=>Workspace.FolderLabel(x));
    private string DestinationLabel => Workspace.FolderLabel(folderId)+(create?" / "+newFolder.Trim():"");
    protected override void OnParametersSet()
    {
        if(loaded==Job.Id)return;loaded=Job.Id;
        try {suggestion=JsonSerializer.Deserialize<OrganizationSuggestion>(Job.OrganizationJson)??new(Guid.Empty,"",Entry.Name,"");}
        catch(JsonException) {error="This saved proposal could not be read. Request a new AI reading.";}
        folderId=suggestion.DestinationFolderId;filename=suggestion.Filename;newFolder=suggestion.NewFolder;create=newFolder.Length>0;category=Job.DocumentType;note="";pending=null;remember=true;
    }
    private void Edited() { pending=null;error=null; }
    private async Task Run(Func<Task> action)
    {
        if(busy)return;busy=true;error=null;
        try {await action();}
        catch(Exception ex) {Logger.LogWarning("Organizing approval failed: {Kind}",ex.GetType().Name);error=ex is StorageException?ex.Message:"The filing could not finish. Check Recovery and storage before retrying.";}
        finally {busy=false;}
    }
    private Task Approve()=>Run(async()=>
    {
        var parent=Workspace.Overview.Folders.FirstOrDefault(x=>x.Id==folderId)??throw new StorageException("Choose a destination folder.");
        var expected=StoragePaths.Join(create?StoragePaths.Join(parent.RelativePath,newFolder.Trim()):parent.RelativePath,filename.Trim());
        var plan=await Library.PreviewOrganizationFilingAsync(Job.Id,new(folderId,create?newFolder:"",filename,category,note,remember),await Workspace.ActorAsync());
        if(plan.DestinationPath!=expected) {pending=plan;return;}
        await Apply(plan);
    });
    private Task ApplyPending()=>Run(async()=>{if(pending!=null)await Apply(pending);});
    private async Task Apply(OrganizationFiling plan)
    {
        await Library.ApplyOrganizationFilingAsync(plan.Id,await Workspace.ActorAsync());
        await Filed.InvokeAsync($"Filed as {plan.Filename}."+(plan.Remember?" Your approved choice was remembered.":""));
    }
    private Task Reject()=>Run(async()=>{await Library.RejectOrganizationAsync(Job.Id,await Workspace.ActorAsync());await Changed.InvokeAsync();});
}
